# Captured evidence and its manifests. These are run artefacts, and the log files are
# chmod 444 — they are reproducible from a seed, so they do not belong in the repo.
output/

# Live session state: which firewall changes are outstanding, plus the backup of your
# ufw rules used to undo them. Machine-specific and security-sensitive; committing it
# would publish one machine's firewall configuration and could restore it onto another.
.lab/

# Local defaults set from the console.
pde.conf

# Written by `./vm.sh seed`: the bank's sandbox staff credentials and the database ids
# of one particular Fineract instance. Meaningless on another, and credentials besides.
Banking/seed.json
# Written by Banking/local-bank.sh seed: the same, for a bank on this machine.
Banking/seed.local.json

__pycache__/
