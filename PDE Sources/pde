#!/usr/bin/env bash
# ==============================================================
#  PDE SOURCE CONSOLE
#
#  Interactive front end for the Potential Digital Evidence
#  simulators: configure a scenario, choose how the attacker
#  behaves, capture a window, and read the evidence back.
#
#  The simulators themselves stay flag-driven and scriptable —
#  this console drives them, it does not replace them.
#
#  Usage:  bash "PDE Sources/pde"
# ==============================================================
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FW_DIR="$SCRIPT_DIR/Firewall"
FW_SCRIPT="$FW_DIR/simulate-firewall.sh"
FW_GEN="$FW_DIR/generate_traffic.py"
LAB_SH="$SCRIPT_DIR/lab.sh"
SUBMIT_SCRIPT="$SCRIPT_DIR/submit-evidence.sh"
CONFIG_FILE="${PDE_CONFIG:-$SCRIPT_DIR/pde.conf}"

# Topology, port lists, lab paths and lab_get all come from the one shared file — the
# same one lab.sh and simulate-firewall.sh read. The console previously restated the
# subnet and the port lists locally, and they drifted: the event-plan preview was still
# describing a 14-port sweep after the real list grew to 35, so it showed the operator a
# histogram for a run that would not happen. A preview that disagrees with the capture is
# worse than no preview.
PDE_ROOT="$SCRIPT_DIR"
# shellcheck source=lab-config.sh
source "$SCRIPT_DIR/lab-config.sh"

# ---- scenario defaults ---------------------------------------
USERS=10
DURATION=30
RATE=20
MALICIOUS_PCT=10
MALICIOUS_USERS=1
ATTACK_PROFILE=port-scan
SEED=1337
OUTDIR="$SCRIPT_DIR/output"

# IDS correlation: Slips observes the same packets the firewall logs. With IDS_REMOTE the
# lab captures the veth here and Slips analyses each window on the research VM; without
# it, Slips runs locally in Docker and sniffs the veth live.
WITH_IDS=0
IDS_REMOTE=1
IDS_DRAIN=45

# The banking source: the same users drive the bank (Fineract, on the research VM) during
# the window, and its audit trail and event stream are collected for it.
WITH_BANKING=0
BANK_RATE=0.5
BANK_PROFILE=loan-fraud

# ---- evidence repository -------------------------------------
# Where a captured window goes once it is evidence. On the research VM by default, reached
# through the admin tunnel; REPO_ON_VM=0 in pde.conf for a repository run locally.
REPO_ON_VM=1
DFRAAS_AUTH="${DFRAAS_AUTH:-admin:admin}"
# One registered source per PDE source: they are different collectors observing
# different things, and the repository classifies and retains per source.
DFRAAS_SOURCE_KEY="${DFRAAS_SOURCE_KEY:-pde-sim-ufw-01}"
DFRAAS_IDS_SOURCE_KEY="${DFRAAS_IDS_SOURCE_KEY:-pde-sim-slips-01}"
DFRAAS_BANK_EVENTS_SOURCE_KEY="${DFRAAS_BANK_EVENTS_SOURCE_KEY:-pde-sim-fineract-events-01}"
DFRAAS_BANK_AUDIT_SOURCE_KEY="${DFRAAS_BANK_AUDIT_SOURCE_KEY:-pde-sim-fineract-audit-01}"

[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

# Decided after pde.conf, since REPO_ON_VM may be set there. An explicit DFRAAS_URL wins.
if [ -z "${DFRAAS_URL:-}" ]; then
	if [ "$REPO_ON_VM" = "1" ]; then DFRAAS_URL="http://localhost:${VM_LOCAL_REPO_PORT}"
	else DFRAAS_URL="http://localhost:8080"; fi
fi

# shellcheck source=Remote/vm-lib.sh
source "$SCRIPT_DIR/Remote/vm-lib.sh"
BANK_SEED="${BANK_SEED:-$SCRIPT_DIR/Banking/seed.json}"
VM_SH="$SCRIPT_DIR/vm.sh"

# ---- palette -------------------------------------------------
# Matches Anomaly Detection/Scripts/slips-cli.sh so the two consoles read as
# one product rather than two tools that happen to share a repo.
C_TITLE=$'\033[1;38;5;74m'
C_DIM=$'\033[38;5;244m'
C_OK=$'\033[38;5;72m'
C_WARN=$'\033[38;5;179m'
C_ERR=$'\033[38;5;167m'
C_KEY=$'\033[38;5;179m'
C_NUM=$'\033[1;38;5;110m'
C_RULE=$'\033[38;5;238m'
R=$'\033[0m'

rule() { printf '%s%s%s\n' "$C_RULE" "──────────────────────────────────────────────────────────────" "$R"; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$R"; }
ok()   { printf '  %s✓%s %s\n' "$C_OK" "$R" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_WARN" "$R" "$*"; }
err()  { printf '  %s✗%s %s\n' "$C_ERR" "$R" "$*"; }
head_(){ printf '\n%s%s%s\n' "$C_TITLE" "$*" "$R"; }
pause(){ printf '\n%s  press enter to continue%s' "$C_DIM" "$R"; read -r _; }
kv()   { printf '    %s%-28s%s %s\n' "$C_DIM" "$1" "$R" "$2"; }

# ---- state ---------------------------------------------------
# down  — nothing running, the host is untouched
# up    — infrastructure standing; captures run against it
# stale — a session was recorded but its namespace is gone (reboot). The firewall may
#         still be carrying the test rules, and nothing is running that would undo it.
lab_state() {
	[ -f "$LAB_STATE" ] || { echo down; return; }
	# Via lab_get from lab-config.sh, not a private grep: values are quoted, and reading
	# LAB_NS as `"pde-fw"` fails to match the namespace and reports a live lab as stale.
	# One reader for the state file, shared with lab.sh, so that cannot diverge either.
	local ns; ns="$(lab_get LAB_NS "$NS")"
	if ip netns list 2>/dev/null | awk '{print $1}' | grep -qx "$ns"; then
		echo up
	else
		echo stale
	fi
}

ufw_enabled()  { grep -E '^ENABLED='  /etc/ufw/ufw.conf 2>/dev/null | cut -d= -f2; }
ufw_loglevel() { grep -E '^LOGLEVEL=' /etc/ufw/ufw.conf 2>/dev/null | cut -d= -f2; }
rsyslog_up()   { pgrep -x rsyslogd >/dev/null 2>&1; }

# A captured window is a directory named for its timestamp, holding that window's
# evidence. Finding one means finding its manifest, one level down.
#
# `grep -c` prints 0 *and* exits 1 with no matches, so `grep -c ... || echo 0` emits
# "0\n0" and shifts every later printf argument. Count into a variable.
run_manifests() {
	[ -d "$OUTDIR" ] || return 0
	find "$OUTDIR" -mindepth 2 -maxdepth 2 -name 'firewall_*.manifest.json' 2>/dev/null | sort
}

run_count() {
	local n; n=$(run_manifests | grep -c . 2>/dev/null)
	printf '%s' "${n:-0}"
}

latest_run() {
	local f; f=$(run_manifests | tail -1)
	[ -n "$f" ] || return 1
	basename "$(dirname "$f")"
}

# Reads one value out of a run's manifest. The expression is evaluated against
# `m`, the parsed manifest.
manifest_field() {
	python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); print(eval(sys.argv[2]))' \
		"$OUTDIR/$1/firewall_$1.manifest.json" "$2" 2>/dev/null
}

# ---- status banner -------------------------------------------
banner() {
	clear
	rule
	printf '%s  PDE SOURCE CONSOLE%s\n' "$C_TITLE" "$R"
	rule

	local lab; lab="$(lab_state)"
	case "$lab" in
		up)    printf '  %s\n' "${C_OK}● LAB UP${R}  ${C_DIM}since $(lab_get LAB_STARTED_UTC)   ufw carrying test rules   $([ "$(lab_get LAB_WITH_IDS)" = "1" ] && echo "slips running" || echo "no ids")${R}" ;;
		stale) printf '  %s\n' "${C_ERR}● LAB STALE${R}  ${C_DIM}session did not survive; your firewall may still be modified — option 1 to recover${R}" ;;
		*)     printf '  %s\n' "${C_DIM}○ lab down   the host is untouched${R}" ;;
	esac

	local fw rs en
	en="$(ufw_enabled)"
	if [ "$en" = "yes" ]; then fw="${C_WARN}active${R}"; else fw="${C_DIM}inactive${R}"; fi
	if rsyslog_up; then rs="${C_OK}running${R}"; else rs="${C_ERR}stopped${R}"; fi
	printf '  %sufw%s %-22b %srsyslog%s %-22b %sloglevel%s %s\n' \
		"$C_DIM" "$R" "$fw" "$C_DIM" "$R" "$rs" "$C_DIM" "$R" "$(ufw_loglevel)"

	# Assembled as single strings then printed with one %s each, so an argument
	# count can never drift out of step with the format.
	printf '  %s\n' "${C_DIM}users${R} ${C_KEY}${USERS}${R} ${C_DIM}(${MALICIOUS_USERS} attacking)${R}   ${C_DIM}window${R} ${C_KEY}${DURATION}s${R}   ${C_DIM}rate${R} ${C_KEY}${RATE}/s${R}   ${C_DIM}malicious${R} ${C_KEY}${MALICIOUS_PCT}%${R}"
	local sources="${C_KEY}firewall${R}"
	if [ "$WITH_IDS" = "1" ]; then
		sources="${sources} ${C_DIM}+${R} ${C_KEY}ids${R}$([ "$IDS_REMOTE" = "1" ] && printf '%s' "${C_DIM}(vm)${R}")"
	fi
	if [ "$WITH_BANKING" = "1" ]; then
		sources="${sources} ${C_DIM}+${R} ${C_KEY}banking${R}${C_DIM}(vm)${R}"
	fi
	[ "$WITH_IDS" != "1" ] && [ "$WITH_BANKING" != "1" ] && sources="${sources} ${C_DIM}only${R}"
	printf '  %s\n' "${C_DIM}profile${R} ${C_KEY}${ATTACK_PROFILE}${R}   ${C_DIM}seed${R} ${C_KEY}${SEED}${R}   ${C_DIM}sources${R} ${sources}"

	local n; n="$(run_count)"
	if [ "${n:-0}" -gt 0 ]; then
		local last lines blocked
		last="$(latest_run)"
		lines="$(manifest_field "$last" 'm["output"]["lines"]')"
		blocked="$(manifest_field "$last" 'm["output"]["ufw_block_lines"]')"
		printf '  %s\n' "${C_DIM}captured${R} ${C_KEY}${n}${R}   ${C_DIM}latest${R} ${C_KEY}${last}${R} ${C_DIM}(${lines:-?} lines, ${C_ERR}${blocked:-?} BLOCK${C_DIM})${R}"
	else
		printf '  %s\n' "${C_DIM}captured${R} ${C_DIM}nothing yet${R}"
	fi
	rule
}

# ---- profile catalogue ---------------------------------------
# Short signature lines rather than shelling to the generator on every redraw:
# the menu has to stay instant, and this is what the log actually shows.
profile_signature() {
	case "$1" in
		port-scan)   printf 'VERTICAL: one target, many ports — down the port list' ;;
		brute-force) printf 'one SRC, one DPT, many SPTs — repeated BLOCKs on 22' ;;
		db-probe)    printf 'database ports only — narrow and deliberate' ;;
		stealth)     printf 'evenly spaced, maximal gaps — slips rate thresholds' ;;
		syn-burst)   printf 'every attempt in one short spike against one port' ;;
		mixed)       printf 'sweep first, then pressure on a single port' ;;
		guaranteed-alert) printf 'ALLOWED conns to ports Slips cannot name — built to alert' ;;
		*)           printf 'unknown profile' ;;
	esac
}

profile_menu() {
	local names="port-scan brute-force db-probe stealth syn-burst mixed guaranteed-alert"
	while true; do
		banner
		head_ "Choose how the attacker behaves"
		dim "  A firewall log has no 'malicious' column — only a source, a destination"
		dim "  port and a verdict. An attack is therefore only ever a shape."
		echo
		local i=1 p mark
		for p in $names; do
			if [ "$p" = "$ATTACK_PROFILE" ]; then mark="${C_OK}◂ selected${R}"; else mark=""; fi
			printf '  %s%s%s  %-17s %s%-46s%s %b\n' "$C_NUM" "$i" "$R" "$p" \
				"$C_DIM" "$(profile_signature "$p")" "$R" "$mark"
			i=$((i + 1))
		done
		echo
		if [ "$ATTACK_PROFILE" = "guaranteed-alert" ]; then
			dim "  guaranteed-alert completes connections to ports ${ALERT_PORTS}, which the"
			dim "  firewall permits, so Slips raises one HIGH finding per connection and crosses"
			dim "  its alert threshold. The alert is the IDS's to raise:"
			if [ "$WITH_IDS" = "1" ]; then
				dim "  the IDS source is on."
			else
				warn "  the IDS source is OFF — turn it on under option 1, or nothing can alert."
			fi
			echo
		fi
		printf '  %s8%s  Preview this profile %s(port histogram, no packets sent)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		echo
		printf '  %s0%s  back\n' "$C_NUM" "$R"
		echo
		printf '  %sselect>%s ' "$C_TITLE" "$R"; read -r a

		case "$a" in
			1) ATTACK_PROFILE=port-scan;   persist ATTACK_PROFILE ;;
			2) ATTACK_PROFILE=brute-force; persist ATTACK_PROFILE ;;
			3) ATTACK_PROFILE=db-probe;    persist ATTACK_PROFILE ;;
			4) ATTACK_PROFILE=stealth;     persist ATTACK_PROFILE ;;
			5) ATTACK_PROFILE=syn-burst;   persist ATTACK_PROFILE ;;
			6) ATTACK_PROFILE=mixed;       persist ATTACK_PROFILE ;;
			7) ATTACK_PROFILE=guaranteed-alert; persist ATTACK_PROFILE ;;
			8) preview_plan ;;
			0|q) return ;;
			*) ;;
		esac
	done
}

# ---- configuration -------------------------------------------
persist() {
	local key="$1" value="${!1}"
	touch "$CONFIG_FILE" 2>/dev/null || return 0
	if grep -qE "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
		sed -i "s|^${key}=.*|${key}=${value}|" "$CONFIG_FILE"
	else
		printf '%s=%s\n' "$key" "$value" >> "$CONFIG_FILE"
	fi
}

ask_number() {
	local var="$1" prompt="$2" hint="$3" current="${!1}" reply
	printf '\n  %s%s%s\n' "$C_TITLE" "$prompt" "$R"
	dim "  $hint"
	printf '  %scurrent%s %s%s%s   %snew value (enter to keep)>%s ' \
		"$C_DIM" "$R" "$C_KEY" "$current" "$R" "$C_DIM" "$R"
	read -r reply
	[ -z "$reply" ] && return
	case "$reply" in
		*[!0-9.]*|'') err "not a number — keeping $current"; sleep 1; return ;;
	esac
	printf -v "$var" '%s' "$reply"
	persist "$var"
}

configure_menu() {
	while true; do
		banner
		head_ "Scenario configuration"
		dim "  Saved to pde.conf and passed to the simulator on every run."
		echo
		printf '  %s1%s  Users            %s%-7s%s %sone source IP each; a user in a firewall log IS an IP%s\n' "$C_NUM" "$R" "$C_KEY" "$USERS" "$R" "$C_DIM" "$R"
		printf '  %s2%s  Duration         %s%-7s%s %sseconds captured — this is the EvidenceItem window%s\n'    "$C_NUM" "$R" "$C_KEY" "${DURATION}s" "$R" "$C_DIM" "$R"
		printf '  %s3%s  Rate             %s%-7s%s %sattempts per second, all users combined%s\n'               "$C_NUM" "$R" "$C_KEY" "${RATE}/s" "$R" "$C_DIM" "$R"
		printf '  %s4%s  Malicious share  %s%-7s%s %spercentage of EVENTS that are malicious%s\n'               "$C_NUM" "$R" "$C_KEY" "${MALICIOUS_PCT}%" "$R" "$C_DIM" "$R"
		printf '  %s5%s  Attackers        %s%-7s%s %show many USERS attack — a separate knob from 4%s\n'        "$C_NUM" "$R" "$C_KEY" "$MALICIOUS_USERS" "$R" "$C_DIM" "$R"
		printf '  %s6%s  Seed             %s%-7s%s %ssame seed, same run — keep it for reproducibility%s\n'     "$C_NUM" "$R" "$C_KEY" "$SEED" "$R" "$C_DIM" "$R"

		# Every user cannot be an attacker: the run needs a benign baseline to contrast
		# against, and the simulator refuses. Said here, at the point of setting it,
		# rather than at the point of capture.
		if [ "$MALICIOUS_USERS" -ge "$USERS" ] 2>/dev/null; then
			echo
			warn "Attackers (${MALICIOUS_USERS}) must be fewer than users (${USERS})."
			dim "    A capture needs benign traffic to contrast the attack against, so"
			dim "    the simulator will refuse this. Lower 5, or raise 1."
		fi

		# Users is the one knob here that a running session has already committed to.
		if [ "$(lab_state)" = "up" ]; then
			local lab_users; lab_users="$(lab_get LAB_USERS 0)"
			if [ "$USERS" -gt "${lab_users:-0}" ]; then
				echo
				warn "The running sources have only ${lab_users} user addresses."
				dim "    They are created at start-up, so a capture cannot use more than that."
				dim "    Restart the sources (option 1 → 2) to apply ${USERS}."
			fi
		fi
		echo
		# Whether the IDS runs at all is a question about sources, and lives on the
		# sources screen. It used to be togglable here too, which left one setting with
		# two controls and no way to tell which was authoritative. Only the drain stays,
		# because it describes the capture rather than the source.
		if [ "$WITH_IDS" = "1" ]; then
			printf '  %s7%s  IDS drain        %s%-7s%s %sseconds Slips keeps running past the window,%s\n' "$C_NUM" "$R" "$C_KEY" "${IDS_DRAIN}s" "$R" "$C_DIM" "$R"
			printf '  %s                    %s%-7s%s %sso it can raise evidence for it%s\n' "$C_DIM" "" "" "$R" "$C_DIM" "$R"
		else
			printf '  %s   %s IDS drain        %s—       the IDS source is off; option 1 turns it on%s\n' "$C_DIM" "$R" "$C_DIM" "$R"
		fi
		echo
		local total mal
		total=$(awk "BEGIN{printf \"%d\", $DURATION * $RATE}")
		mal=$(awk "BEGIN{printf \"%d\", $DURATION * $RATE * $MALICIOUS_PCT / 100}")
		printf '  %s\n' "${C_DIM}this scenario produces${R} ${C_KEY}${total}${R} ${C_DIM}events, of which${R} ${C_KEY}${mal}${R} ${C_DIM}are malicious${R}"
		echo
		printf '  %s0%s  back\n' "$C_NUM" "$R"
		echo
		printf '  %sselect>%s ' "$C_TITLE" "$R"; read -r a

		case "$a" in
			1) ask_number USERS           "Number of simulated users" "the brief says 10" ;;
			2) ask_number DURATION        "Capture window in seconds" "the brief says 30" ;;
			3) ask_number RATE            "Events per second"         "20 gives 600 events across a 30s window" ;;
			4) ask_number MALICIOUS_PCT   "Malicious share of events" "the brief says 10%" ;;
			5) ask_number MALICIOUS_USERS "How many users attack"     "1 of 10. Note 10:1 users is 9.09%, not 10% — these are different claims" ;;
			6) ask_number SEED            "Random seed"               "any integer; the whole run is reproducible from it" ;;
			7) if [ "$WITH_IDS" = "1" ]; then
					ask_number IDS_DRAIN "Seconds to drain Slips after the window" \
						"Slips raises evidence in batches; collecting immediately gets an empty file"
				fi ;;
			0|q) return ;;
			*) ;;
		esac
	done
}

# ---- preview -------------------------------------------------
preview_plan() {
	banner
	head_ "Event plan for '$ATTACK_PROFILE'"
	dim "  Built from seed $SEED. No packets are sent and nothing is changed."
	echo
	# Addresses and ports come from lab-config.sh, the same values the capture uses.
	# Restating them here is what made this preview describe a different run.
	local ips="" mal="" i
	for i in $(seq 1 "$USERS"); do
		ips="${ips}${ips:+,}${USER_IP_BASE}$((USER_IP_OFFSET + i))"
	done
	for i in $(seq 0 $((MALICIOUS_USERS - 1))); do
		mal="${mal}${mal:+,}${USER_IP_BASE}$((USER_IP_OFFSET + USERS - i))"
	done

	python3 "$FW_GEN" --plan-only \
		--users "$ips" --malicious-users "$mal" --target "$HOST_IP" \
		--duration "$DURATION" --rate "$RATE" --malicious-pct "$MALICIOUS_PCT" \
		--attack-profile "$ATTACK_PROFILE" \
		--benign-ports "$BENIGN_PORTS" \
		--malicious-ports "$MALICIOUS_PORTS" \
		--alert-ports "$ALERT_PORTS" \
		--seed "$SEED" --out /dev/null 2>&1 \
	| python3 -c 'import json,sys
d = json.load(sys.stdin)
print("    %-20s %s" % ("planned events", d["planned_events"]))
print("    %-20s %s" % ("malicious", d["malicious_events"]))
print("    %-20s %s" % ("benign", d["benign_events"]))
g = d.get("alert_guarantee")
if g:
    print()
    print("    %-20s %s" % ("per attacker", ", ".join("%s: %s" % kv for kv in g["planned_per_attacker"].items())))
    print("    %-20s %s completed each (%.1f per connection, threshold %.0f)"
          % ("Slips needs", g["min_completed_per_attacker"], g["weight_per_completed_connection"], g["slips_threshold"]))
h = d["malicious_port_histogram"]
if h:
    top, low = max(h.values()), min(h.values())
    print()
    print("    %-20s %s" % ("distinct ports hit", len(h)))
    print("    %-20s %s" % ("attempts per port", low if low == top else "%s-%s" % (low, top)))
    # A vertical scan spread evenly gives every port the same count, and a bar chart of
    # 35 identical full-width bars says nothing at all. The flatness IS the signature,
    # so name it; draw bars only when there is a shape to see.
    if g:
        print()
        print("    Deliberately not a scan: %d ports, each connection meant to complete." % len(h))
        print("    Slips marks a source a port scanner only for FAILED connections above five")
        print("    ports, so none of the HIGH findings this profile relies on can be suppressed.")
    elif top == low:
        print()
        print("    Every port hit the same number of times — an even sweep, which is")
        print("    what makes this a vertical scan rather than pressure on one service.")
    else:
        print()
        print("    attempts by destination port:")
        for p, n in sorted(h.items(), key=lambda kv: (-kv[1], int(kv[0])))[:12]:
            print("      %-7s %-4s %s" % (p, n, "#" * max(1, int(n * 30 / top))))
        if len(h) > 12:
            print("      ... and %d more ports at %d or fewer" % (len(h) - 12, low))'
	if [ "$WITH_BANKING" = "1" ]; then
		head_ "At the bank — '$BANK_PROFILE'"
		if [ -r "$BANK_SEED" ]; then
			python3 "$SCRIPT_DIR/Banking/generate_banking.py" --plan-only --seed-file "$BANK_SEED" \
				--users "$ips" --malicious-users "$mal" --duration "$DURATION" --rate "$BANK_RATE" \
				--profile "$BANK_PROFILE" --seed "$SEED" 2>&1 \
			| python3 -c 'import json,sys
d = json.load(sys.stdin)
print("    %-20s %s  %s" % ("benign operations", d["benign_operations"],
      ", ".join("%s %s" % kv for kv in sorted(d["benign_by_kind"].items()))))
c = d.get("fraud_chain")
if c:
    print("    %-20s %s, logged in as %s, loan of %s" % ("fraud", c["attacker"], c["as_user"], c["principal"]))
    for s in c["steps"]:
        print("      %5.1fs  %s" % (s["at_s"], s["kind"]))'
		else
			dim "    the bank has not been seeded — sources screen, option s"
		fi
	fi
	echo
	dim "  This shape is all detection has to work with. Worth comparing profiles"
	dim "  before committing to one for the dataset."
	pause
}

preview_firewall() {
	banner
	head_ "What a run would change"
	dim "  Nothing below has been applied — this is the dry run."
	echo
	"$FW_SCRIPT" --dry-run --users "$USERS" --duration "$DURATION" \
		--malicious-pct "$MALICIOUS_PCT" --malicious-users "$MALICIOUS_USERS" \
		--attack-profile "$ATTACK_PROFILE" 2>&1 | sed 's/^/  /'
	pause
}

# ---- capture -------------------------------------------------
run_capture() {
	banner
	head_ "Capture a window"
	dim "  Real packets cross the real INPUT chain, and the log lines are written by"
	dim "  the kernel rather than by us. Only the scenario is synthetic."
	echo
	local srcs="firewall (ufw)"
	[ "$WITH_IDS" = "1" ] && srcs="$srcs + ids (Slips$([ "$IDS_REMOTE" = "1" ] && echo ' on the VM'))"
	[ "$WITH_BANKING" = "1" ] && srcs="$srcs + banking (Fineract events + audit)"
	kv "sources" "$srcs"
	kv "users"     "$USERS ($MALICIOUS_USERS attacking)"
	kv "window"    "${DURATION}s at ${RATE}/s"
	kv "profile"   "$ATTACK_PROFILE"
	kv ""          "$(profile_signature "$ATTACK_PROFILE")"
	kv "malicious" "${MALICIOUS_PCT}% of events"
	[ "$WITH_BANKING" = "1" ] && kv "bank" "${BANK_PROFILE}, benign ${BANK_RATE}/s"
	if [ "$ATTACK_PROFILE" = "guaranteed-alert" ] && [ "$WITH_IDS" != "1" ]; then
		echo
		warn "guaranteed-alert with the IDS off: the traffic is sent, but nothing can raise the alert."
		dim "    Turn the IDS on under option 1 first."
	fi
	echo
	# What this costs and what it touches both depend on whether the sources are already
	# standing. Saying "this enables ufw" while a lab has it enabled already is simply
	# untrue, and quoting Slips' start-up time when Slips is running overstates the wait
	# by about a minute.
	local state; state="$(lab_state)"
	# The bank lives on the VM and is reached through the lab's tunnel, so there is no
	# one-shot path for it. Said here, before sudo is asked for, not after.
	if [ "$WITH_BANKING" = "1" ] && [ "$state" != "up" ]; then
		echo
		err "The banking source needs the sources running — its tunnel to the bank belongs to them."
		dim "    Start them under option 1 first."
		pause
		return
	fi
	if [ "$state" = "up" ]; then
		if [ "$(lab_get LAB_WITH_IDS 0)" = "1" ] && [ "$(lab_get LAB_IDS_MODE local)" = "remote" ]; then
			dim "    The veth has been captured since the sources started. After the window its"
			dim "    packets go to Slips on the VM. Expect about $(( DURATION + 75 ))s: the window, then"
			dim "    about a minute of analysis$([ "$(lab_get LAB_WITH_BANKING 0)" = "1" ] && echo ", with the bank's evidence collected meanwhile")."
		elif [ "$(lab_get LAB_WITH_IDS 0)" = "1" ]; then
			dim "    Slips is already reading the veth, so both sources see this window."
			dim "    Expect about $(( DURATION + IDS_DRAIN ))s: the window, then ${IDS_DRAIN}s for Slips to"
			dim "    raise evidence for it."
		elif [ "$(lab_get LAB_WITH_BANKING 0)" = "1" ]; then
			dim "    Expect about $(( DURATION + 30 ))s: the window, then the bank's evidence collected on the VM."
		else
			dim "    Expect about ${DURATION}s."
		fi
		echo
		dim "    The sources are already running and stay running. This reads a window"
		dim "    against them — it does not change your firewall, which the lab already"
		dim "    configured and will restore when you stop it."
	else
		if [ "$WITH_IDS" = "1" ]; then
			dim "    Slips attaches to the veth before the window opens and keeps running"
			dim "    ${IDS_DRAIN}s past it, so both sources describe the same packets. Expect roughly"
			dim "    $(( 60 + DURATION + IDS_DRAIN ))s in total — most of it Slips loading its modules."
			echo
		fi
		warn "This enables ufw and modifies the host firewall for ${DURATION}s."
		dim "    Your ruleset, ENABLED and LOGLEVEL are snapshotted and restored on exit,"
		dim "    including on Ctrl-C. Option 5 shows the exact changes first."
		if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
			local c; c=$(docker ps -q 2>/dev/null | wc -l)
			[ "${c:-0}" -gt 0 ] && dim "    ${c} container(s) running; ufw sets FORWARD to DROP while it is active."
		fi
	fi
	# The namespace addresses are created when the sources start, so Users is fixed for
	# the life of a session. Caught here, where it can be explained, rather than letting
	# the simulator die part-way through with an error that reads like a traffic fault.
	if [ "$state" = "up" ]; then
		local lab_users; lab_users="$(lab_get LAB_USERS 0)"
		if [ "$USERS" -gt "${lab_users:-0}" ]; then
			echo
			err "The running sources have ${lab_users} user addresses; the scenario asks for ${USERS}."
			dim "    Addresses are created when the sources start, so this needs a restart:"
			dim "    option 1 → 2. Or set Users back to ${lab_users} under option 4."
			pause
			return
		fi
	fi

	echo
	printf '  %sproceed? [y/N]>%s ' "$C_TITLE" "$R"; read -r go
	case "$go" in
		y|Y) ;;
		*) dim "  cancelled"; pause; return ;;
	esac

	echo
	local args=(--users "$USERS" --duration "$DURATION" --rate "$RATE"
		--malicious-pct "$MALICIOUS_PCT" --malicious-users "$MALICIOUS_USERS"
		--attack-profile "$ATTACK_PROFILE" --seed "$SEED" --outdir "$OUTDIR")
	if [ "$WITH_IDS" = "1" ]; then
		args+=(--with-ids --ids-drain "$IDS_DRAIN")
	fi
	if [ "$WITH_BANKING" = "1" ]; then
		args+=(--with-banking --bank-rate "$BANK_RATE" --bank-profile "$BANK_PROFILE")
	fi

	local rc=0
	if [ "$(id -u)" -ne 0 ]; then
		sudo "$FW_SCRIPT" "${args[@]}" || rc=$?
	else
		"$FW_SCRIPT" "${args[@]}" || rc=$?
	fi
	echo
	if [ "$rc" -eq 0 ]; then ok "capture complete — option 7 reads it back"
	else err "the simulator exited with status $rc"; fi
	pause
}

# ---- evidence ------------------------------------------------
require_run() {
	if ! latest_run >/dev/null 2>&1; then
		banner
		head_ "Nothing captured yet"
		dim "  Option 2 runs a capture."
		pause
		return 1
	fi
	return 0
}

# Lists runs and returns the chosen id. With only one run it returns that one
# without asking, so the common case stays a single keypress.
#
# Everything it DRAWS goes to stderr; only the chosen id goes to stdout. The caller
# reads it with $( ), which captures stdout — so a menu drawn on stdout is not shown
# at all, and is instead returned as the "run id". That produced a filename made of a
# whole screenful of escape codes and an "OSError: File name too long", for every user
# with more than one capture.
pick_run() {
	local runs count
	runs=$(run_manifests)
	count=$(printf '%s\n' "$runs" | grep -c . 2>/dev/null)
	if [ "${count:-0}" -le 1 ]; then latest_run; return; fi

	{
		banner
		head_ "Captured windows"
		echo
		local i=1 f id detail
		while IFS= read -r f; do
			[ -n "$f" ] || continue
			id=$(basename "$(dirname "$f")")
			detail=$(manifest_field "$id" 'm["configuration"]["attack_profile"]+"   "+str(m["output"]["lines"])+" lines, "+str(m["output"]["ufw_block_lines"])+" BLOCK"')
			printf '  %s%s%s  %-16s %s%s%s\n' "$C_NUM" "$i" "$R" "$id" "$C_DIM" "$detail" "$R"
			i=$((i + 1))
		done <<< "$runs"
		echo
		printf '  %sselect 1-%s (enter for latest)>%s ' "$C_TITLE" "$count" "$R"
	} >&2

	local sel
	read -r sel || { latest_run; return; }
	[ -z "$sel" ] && { latest_run; return; }

	# Anything that is not a row number falls back to the latest and says so. It used to
	# be fed straight to `sed -n "${sel}p"`, so a typo became a sed syntax error and the
	# console quietly showed a different run than the one asked for.
	case "$sel" in
		*[!0-9]*) printf '  not a row number — showing the latest instead\n' >&2
		          latest_run; return ;;
	esac
	if [ "$sel" -lt 1 ] || [ "$sel" -gt "$count" ]; then
		printf '  there is no run %s — showing the latest instead\n' "$sel" >&2
		latest_run; return
	fi

	basename "$(dirname "$(printf '%s\n' "$runs" | sed -n "${sel}p")")"
}

view_evidence() {
	require_run || return
	local run; run="$(pick_run)"
	[ -n "$run" ] || return
	banner
	head_ "Run $run"
	python3 -c 'import json,sys
m = json.load(open(sys.argv[1]))
s, c, w, o = m["source"], m["configuration"], m["window"], m["output"]
def kv(k, v): print("    %-22s %s" % (k, v))
kv("source", "%s (%s)" % (s["pde_source"], s["version"]))
kv("window", "%s -> %s" % (w["start_utc"], w["end_utc"]))
kv("users", "%s (%s attacking)" % (c["users"], c["malicious_users"]))
kv("profile", c.get("attack_profile", "-"))
kv("seed", c["seed"])
print()
kv("log lines", o["lines"])
kv("  UFW BLOCK", o["ufw_block_lines"])
kv("  UFW ALLOW", o["ufw_allow_lines"])
# At logging full every packet also gets an AUDIT line, so lines will exceed the
# event count. Shown rather than hidden, otherwise the totals look wrong.
kv("  UFW AUDIT", o.get("ufw_audit_lines", "-"))
kv("sha256", o["sha256"][:40] + "...")' "$OUTDIR/$run/firewall_${run}.manifest.json"

	# When the window was captured with --with-ids there is a second, independent
	# account of the same packets. Showing them together is the whole point.
	local group="$OUTDIR/$run/window_${run}.group.json"
	if [ -f "$group" ] && grep -q '"pde_source": "ids"' "$group"; then
		head_ "IDS — same window, independent source"
		python3 -c 'import json,sys
g = json.load(open(sys.argv[1]))
ids = next((i for i in g["items"] if i["pde_source"] == "ids"), None)
def kv(k, v): print("    %-22s %s" % (k, v))
if ids:
    kv("product", ids["product"])
    kv("evidence lines", "%s in window (%s seen in total)"
       % (ids["evidence_lines"], ids["evidence_lines_seen_total"]))
    t = ids["threat_levels"]
    kv("threat levels", "  ".join("%s %s" % (n, t[n]) for n in
        ("critical", "high", "medium", "low", "info")))
    kv("alerts", ids.get("alerts", "-"))
    kv("sha256", (ids["sha256"] or "-")[:40] + ("..." if ids["sha256"] else ""))' "$group"

		local ids_log="$OUTDIR/$run/ids_${run}.alerts.log"
		if [ -s "$ids_log" ]; then
			echo
			python3 "$SCRIPT_DIR/../Anomaly Detection/Scripts/slips-format.py" --brief \
				< "$ids_log" 2>/dev/null | head -8 | sed 's/^/    /' \
				|| head -4 "$ids_log" | sed 's/^/    /'
		else
			echo
			dim "    Slips raised nothing inside this window."
		fi
	fi

	# The bank's two accounts of the same window: what happened (events) and who did it
	# (audit). The attacker's commands are shown as the audit trail recorded them.
	local bank_manifest="$OUTDIR/$run/banking_${run}.manifest.json"
	if [ -f "$bank_manifest" ]; then
		head_ "Bank — same window, same users"
		python3 -c 'import json,sys
m = json.load(open(sys.argv[1]))
def kv(k, v): print("    %-22s %s" % (k, v))
sc, comp, col = m["scenario"], m["completeness"], m["collection"]
kv("product", "%s (%s)" % (m["source"]["product"], m["source"]["image"]))
kv("scenario", "%s — attacker %s as %s" % (sc["profile"], sc.get("attacker_ip") or "-", sc.get("attacker_used_login") or "-"))
kv("events", "%s in window  %s" % (col["banking-events"]["events_in_window"], comp["banking-events"]))
kv("audit rows", "%s in window  %s" % (col["banking-audit"]["rows"], comp["banking-audit"]))
clk = m["timestamps"].get("bank_minus_lab_seconds")
if clk:
    kv("bank clock", "%+.3fs vs this machine (median, incl. latency)" % clk["median"])
login = sc.get("attacker_used_login")
if login:
    print()
    print("    what %s did, as the bank recorded it:" % login)
    for line in open(sys.argv[2]):
        r = json.loads(line)
        if r.get("maker_username") == login:
            print("      %s  %-8s %-14s id %s" % (r["made_on_date_utc"][11:23], r["action_name"], r["entity_name"], r["resource_id"]))' \
			"$bank_manifest" "$OUTDIR/$run/banking-audit_${run}.jsonl" 2>/dev/null \
			|| dim "    could not read the banking manifest"
	fi

	head_ "Evidence — first 12 lines"
	sed -e "s/\[UFW BLOCK\]/${C_ERR}[UFW BLOCK]${R}/g" \
		-e "s/\[UFW ALLOW\]/${C_OK}[UFW ALLOW]${R}/g" \
		-e "s/\[UFW AUDIT\]/${C_DIM}[UFW AUDIT]${R}/g" \
		-e "s/\(SRC=[0-9.]*\)/${C_TITLE}\1${R}/g" \
		-e "s/\(DPT=[0-9]*\)/${C_KEY}\1${R}/g" \
		"$OUTDIR/$run/firewall_${run}.log" 2>/dev/null | head -12 | sed 's/^/    /'
	echo
	dim "  window:  $OUTDIR/$run/"
	dim "  files:   $(cd "$OUTDIR/$run" && ls -1 | grep -v '^ids_[0-9]*$' | tr '\n' ' ')"
	pause
}

verify_evidence() {
	require_run || return
	local run; run="$(pick_run)"
	[ -n "$run" ] || return
	banner
	head_ "Integrity — run $run"
	dim "  The manifest digest was taken before anything else touched the file, which"
	dim "  is the SecureRS rule the Evidence Repository follows on ingest."
	echo
	# Every artifact the window holds, each against the digest recorded when it was taken:
	# the firewall's in its own manifest, the others' in the group manifest.
	local rows
	rows=$(python3 -c 'import json,os,sys
run_dir, run = sys.argv[1], sys.argv[2]
fw = json.load(open(os.path.join(run_dir, "firewall_%s.manifest.json" % run)))
print("firewall", "firewall_%s.log" % run, fw["output"]["sha256"])
g = os.path.join(run_dir, "window_%s.group.json" % run)
if os.path.exists(g):
    for i in json.load(open(g))["items"]:
        if i["pde_source"] != "firewall":
            print(i["pde_source"], i["file"], i["sha256"] or "-")' "$OUTDIR/$run" "$run" 2>/dev/null)
	local src file recorded actual bad=0
	while read -r src file recorded; do
		[ -n "$src" ] || continue
		actual="$(sha256sum "$OUTDIR/$run/$file" 2>/dev/null | cut -d' ' -f1)"
		if [ -n "$actual" ] && [ "$recorded" = "$actual" ]; then
			printf '  %s✓%s %-15s %-40s %s\n' "$C_OK" "$R" "$src" "$file" "${C_DIM}${actual:0:16}…${R}"
		else
			printf '  %s✗%s %-15s %-40s %s\n' "$C_ERR" "$R" "$src" "$file" "recorded ${recorded:0:16}… now ${actual:-missing}"
			bad=1
		fi
	done <<< "$rows"
	echo
	if [ "$bad" = "0" ]; then
		ok "every artifact matches — unmodified since capture"
	else
		err "MISMATCH — an artifact has changed since it was captured"
	fi
	pause
}

submit_evidence() {
	require_run || return
	local run; run="$(pick_run)"
	[ -n "$run" ] || return

	# One EvidenceItem references one artifact, so a window holding both a firewall log
	# and an IDS log is two items from two sources — chosen here one at a time rather
	# than uploaded together, which would misrepresent what an item is.
	local group="$OUTDIR/$run/window_${run}.group.json"
	# Row number, source name, artifact file, registered key. Every source's evidence is
	# one file and one item; none is bundled with another.
	local rows=(
		"1 firewall firewall_${run}.log $DFRAAS_SOURCE_KEY"
		"2 ids ids_${run}.alerts.log $DFRAAS_IDS_SOURCE_KEY"
		"3 banking-events banking-events_${run}.jsonl $DFRAAS_BANK_EVENTS_SOURCE_KEY"
		"4 banking-audit banking-audit_${run}.jsonl $DFRAAS_BANK_AUDIT_SOURCE_KEY"
	)

	local source="" key="" file="" digest="" row n s f k
	while true; do
		banner
		head_ "Submit from window $run"
		dim "  One EvidenceItem references one artifact. A window captured from several"
		dim "  sources is therefore several items, each filed under its own registered"
		dim "  source — sent one at a time, not bundled. All carry the same coverage"
		dim "  window, which is what lets correlation line them up afterwards."
		echo
		kv "window" "$(manifest_field "$run" 'm["window"]["start_utc"] + "  ->  " + m["window"]["end_utc"]')"
		kv "repository" "$DFRAAS_URL$([ "$REPO_ON_VM" = "1" ] && echo '  (on the research VM, via the admin tunnel)')"
		echo
		printf '  %s%-3s %-15s %-38s %10s  %s%s\n' "$C_DIM" "" "SOURCE" "ARTIFACT" "BYTES" "FILED UNDER" "$R"
		for row in "${rows[@]}"; do
			read -r n s f k <<< "$row"
			if [ -f "$OUTDIR/$run/$f" ]; then
				printf '  %s%s%s   %-15s %-38s %10s  %s\n' "$C_NUM" "$n" "$R" "$s" "$f" \
					"$(stat -c %s "$OUTDIR/$run/$f")" "$k"
			else
				printf '  %s    %-15s %s%s\n' "$C_DIM" "$s" "not captured for this window" "$R"
			fi
		done
		printf '  %s    %-15s %s%s\n' "$C_DIM" "auth" "not built yet" "$R"
		echo
		dim "  Ground truth is never sent: labels known before the traffic left are"
		dim "  research metadata, and the repository has nowhere truthful to put them."
		echo
		printf '  %s0%s  back\n' "$C_NUM" "$R"
		echo
		printf '  %sselect>%s ' "$C_TITLE" "$R"
		local pick; read -r pick || return
		case "$pick" in 0|q) return ;; esac
		source=""
		for row in "${rows[@]}"; do
			read -r n s f k <<< "$row"
			if [ "$pick" = "$n" ] && [ -f "$OUTDIR/$run/$f" ]; then
				source="$s"; file="$OUTDIR/$run/$f"; key="$k"
			fi
		done
		[ -n "$source" ] && break
	done
	local artifact="${source}_${run}"
	# The firewall's digest lives in its own manifest; every other source's in the group
	# manifest — the record that says they all describe one window.
	if [ "$source" = "firewall" ]; then
		digest="$(manifest_field "$run" 'm["output"]["sha256"]')"
	else
		digest="$(python3 -c 'import json,sys
g = json.load(open(sys.argv[1]))
i = next((x for x in g["items"] if x["pde_source"] == sys.argv[2]), None)
print(i["sha256"] if i else "")' "$group" "$source" 2>/dev/null)"
	fi

	banner
	head_ "Submit the $source artifact from window $run"
	echo
	kv "endpoint"    "$DFRAAS_URL/api/evidence-items"
	kv "source key"  "$key"
	kv "artifact id" "$artifact"
	kv "file"        "$(basename "$file")  ($(stat -c %s "$file") bytes)"
	kv "window"      "$(manifest_field "$run" 'm["window"]["start_utc"] + "  ->  " + m["window"]["end_utc"]')"
	kv "sha256"      "${digest:-unknown}"
	echo
	dim "  The digest goes as a claim. The repository recomputes it from the bytes that"
	dim "  arrive and stores only its own value; a mismatch is a 422 and nothing is kept."
	dim "  This script re-checks the file locally first, so a log that changed since"
	dim "  capture is caught here rather than looking like a transport failure."
	echo
	dim "  The source must be registered once before its first upload — that is where"
	dim "  classification is decided, so it needs a work group id:"
	dim "    ./submit-evidence.sh --source $source --register-with <workGroupId>"
	echo
	printf '  %ssubmit? [y/N]>%s ' "$C_TITLE" "$R"
	local go; read -r go || { dim "  cancelled"; pause; return; }
	case "$go" in
		y|Y) ;;
		*) dim "  cancelled"; pause; return ;;
	esac
	echo
	if [ "$REPO_ON_VM" = "1" ] && ! vm_tunnel_running admin; then
		dim "  opening the admin tunnel to the repository on $VM_NAME..."
		vm_admin_tunnel_start || { err "could not open the admin tunnel — is the VM up? ($VM_SH status)"; pause; return; }
		ADMIN_TUNNEL_OWNED=1
	fi
	DFRAAS_URL="$DFRAAS_URL" DFRAAS_AUTH="$DFRAAS_AUTH" \
	DFRAAS_SOURCE_KEY="$DFRAAS_SOURCE_KEY" DFRAAS_IDS_SOURCE_KEY="$DFRAAS_IDS_SOURCE_KEY" \
	DFRAAS_BANK_EVENTS_SOURCE_KEY="$DFRAAS_BANK_EVENTS_SOURCE_KEY" \
	DFRAAS_BANK_AUDIT_SOURCE_KEY="$DFRAAS_BANK_AUDIT_SOURCE_KEY" \
		"$SUBMIT_SCRIPT" --run "$run" --source "$source" --outdir "$OUTDIR" 2>&1 | sed 's/^/  /'
	pause
}

# ---- teaching ------------------------------------------------
explain() {
	banner
	head_ "What a firewall contributes as evidence"
	dim "  Cheap, high-volume, and strong on reconnaissance. It records WHO connected,"
	dim "  WHAT they reached for, WHEN, and whether it was permitted. It cannot tell"
	dim "  you the payload, the application context, or the identity behind an address"
	dim "  — which is the argument for correlating it with the IDS and authentication"
	dim "  sources over the same window."

	head_ "Anatomy of a ufw log line"
	printf '    %s%s%s\n' "$C_DIM" "Sep  5 19:58:03 host kernel: [8821.443021] [UFW BLOCK] IN=veth-pde-h" "$R"
	printf '    %s%s%s\n' "$C_DIM" "SRC=10.99.0.20 DST=10.99.0.1 PROTO=TCP SPT=51234 DPT=3306 SYN" "$R"
	echo
	kv "Sep  5 19:58:03" "syslog time — no year, no sub-second"
	kv "[8821.443021]"   "kernel uptime — this one does have microseconds"
	kv "[UFW BLOCK]"     "the verdict: BLOCK, ALLOW, AUDIT or LIMIT BLOCK"
	kv "SRC="            "source address — this is what a 'user' is here"
	kv "DPT="            "destination port — what was being reached for"
	kv "SPT="            "source port — a fresh one per attempt"
	kv "SYN"             "TCP flags; SYN alone is an attempt, not a session"

	head_ "Why these logs are real and not generated"
	dim "    The traffic is synthetic — users, window and ratios are all ours to set."
	dim "    The log lines are not: the kernel's netfilter LOG target writes them as"
	dim "    the packets cross the INPUT chain. The format is authentic by"
	dim "    construction, so \"is this really what ufw emits?\" has an answer."

	head_ "The setting that quietly ruins a capture"
	dim "    ufw rate-limits its own LOG rules to 3/min at low, medium and high. A 30s"
	dim "    window would yield about four lines however much traffic you generate."
	dim "    Every run sets logging to full, then restores your previous level."
	pause
}

doctor() {
	banner
	head_ "Environment"
	kv "kernel" "$(uname -r)"
	kv "ufw"    "$(ufw --version 2>/dev/null | head -1 || echo 'not installed')"

	head_ "Can this machine capture ufw logs?"
	if command -v ufw     >/dev/null 2>&1; then ok "ufw installed";      else err "ufw missing — sudo apt install ufw"; fi
	if command -v ip      >/dev/null 2>&1; then ok "iproute2 available"; else err "ip missing"; fi
	if command -v python3 >/dev/null 2>&1; then ok "python3 available";  else err "python3 missing"; fi
	if rsyslog_up; then ok "rsyslogd running"; else err "rsyslogd stopped — sudo systemctl start rsyslog"; fi

	if [ -f /proc/config.gz ] && zcat /proc/config.gz 2>/dev/null | grep -q '^CONFIG_NETFILTER_XT_TARGET_LOG=[my]'; then
		ok "kernel has the netfilter LOG target"
	elif [ -f "/lib/modules/$(uname -r)/kernel/net/netfilter/xt_LOG.ko" ]; then
		ok "kernel has the netfilter LOG target (module present)"
	else
		err "no netfilter LOG target — ufw could filter but never log"
	fi

	mkdir -p "$OUTDIR" 2>/dev/null
	if [ -w "$OUTDIR" ]; then ok "output directory writable"; else err "cannot write to $OUTDIR"; fi

	head_ "Current firewall state"
	kv "ufw enabled"  "$(ufw_enabled)"
	kv "ufw loglevel" "$(ufw_loglevel)"
	[ "$(ufw_loglevel)" != "full" ] && dim "    a run sets this to full, then restores it"
	[ "$(id -u)" -ne 0 ] && dim "    not root — capturing will prompt for sudo"
	if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
		local c; c=$(docker ps -q 2>/dev/null | wc -l)
		[ "${c:-0}" -gt 0 ] && dim "    ${c} container(s) running; ufw sets FORWARD to DROP while active"
	fi

	head_ "The research VM"
	local gbin vst
	if gbin="$(vm_gcloud_bin 2>/dev/null)"; then ok "Linux gcloud at $gbin"
	else err "no Linux gcloud — Remote/install-gcloud.sh (the Windows one on PATH will not do)"; fi
	vst="$(vm_status)"
	case "$vst" in
		RUNNING)
			ok "$VM_NAME is running"
			if vm_ssh true </dev/null >/dev/null 2>&1; then ok "reachable over IAP as $VM_USER"
			else err "SSH over IAP failed — try: $VM_SH ssh"; fi ;;
		"") err "cannot query $VM_NAME — not logged in, or no access (Remote/install-gcloud.sh)" ;;
		*)  warn "$VM_NAME is $vst — $VM_SH start (the IDS on the VM, the bank and the repository all live there)" ;;
	esac
	if [ -r "$BANK_SEED" ]; then ok "the bank has been seeded"
	else warn "the bank has not been seeded — sources screen, option s"; fi
	command -v tcpdump >/dev/null 2>&1 && ok "tcpdump available (IDS capture)" || err "tcpdump missing — apt install tcpdump"

	head_ "Can this machine reach the Evidence Repository?"
	if command -v curl >/dev/null 2>&1; then ok "curl available"; else err "curl missing — submitting needs it"; fi
	if [ "$REPO_ON_VM" = "1" ] && [ "$vst" = "RUNNING" ] && ! vm_tunnel_running admin; then
		dim "    opening the admin tunnel to reach it..."
		vm_admin_tunnel_start >/dev/null 2>&1 && ADMIN_TUNNEL_OWNED=1
	fi

	local health source_code
	# `|| true` rather than `|| echo "000"`: curl already prints 000 from -w when the
	# connection fails, so appending another makes the code "000000" and the branch that
	# explains the failure never matches.
	health=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$DFRAAS_URL/actuator/health" 2>/dev/null || true)
	health="${health:-000}"
	case "$health" in
		200) ok "repository answering at $DFRAAS_URL" ;;
		000) err "no answer from $DFRAAS_URL"
		     dim "    if the backend runs on Windows and this is WSL, localhost may not"
		     dim "    route there. Try the host address instead:"
		     dim "    DFRAAS_URL=http://\$(ip route show default | awk '{print \$3}'):8080" ;;
		*)   warn "$DFRAAS_URL answered HTTP $health on /actuator/health" ;;
	esac

	if [ "$health" = "200" ]; then
		# Each PDE source registers separately, so each is checked separately: the
		# firewall being registered says nothing about whether the IDS is.
		local pair sk src
		for pair in "firewall:$DFRAAS_SOURCE_KEY" "ids:$DFRAAS_IDS_SOURCE_KEY" \
		            "banking-events:$DFRAAS_BANK_EVENTS_SOURCE_KEY" "banking-audit:$DFRAAS_BANK_AUDIT_SOURCE_KEY"; do
			src="${pair%%:*}" sk="${pair#*:}"
			source_code=$(curl -sS -u "$DFRAAS_AUTH" -o /dev/null -w '%{http_code}' --max-time 3 \
				"$DFRAAS_URL/api/evidence-sources?sourceKey=$sk" 2>/dev/null || true)
			source_code="${source_code:-000}"
			case "$source_code" in
				200) ok "source '$sk' is registered" ;;
				404) warn "source '$sk' is not registered yet"
				     dim "    DFRAAS_URL=$DFRAAS_URL ./submit-evidence.sh --source $src --register-with <workGroupId>" ;;
				401) err "credentials rejected — set DFRAAS_AUTH in pde.conf" ;;
				*)   warn "lookup for '$sk' answered HTTP $source_code" ;;
			esac
		done
	fi
	pause
}

# ---- lab lifecycle -------------------------------------------
sudo_run() {
	if [ "$(id -u)" -ne 0 ]; then sudo "$@"; else "$@"; fi
}

# Set when this console started the sources, so it only tears down what it owns. A lab
# someone else left running is reported and left alone.
LAB_OWNED=0
# Likewise for the admin tunnel to the VM, opened on demand by submit, doctor and seeding.
ADMIN_TUNNEL_OWNED=0

lab_bring_up() {
	local args=(up --users "$USERS")
	[ "$WITH_IDS" = "1" ] && args+=(--with-ids)
	[ "$WITH_IDS" = "1" ] && [ "$IDS_REMOTE" = "1" ] && args+=(--ids-remote)
	[ "$WITH_BANKING" = "1" ] && args+=(--with-banking)
	if sudo_run "$LAB_SH" "${args[@]}"; then
		LAB_OWNED=1
		return 0
	fi
	return 1
}

lab_take_down() {
	sudo_run "$LAB_SH" down && LAB_OWNED=0
}

# Runs on quit and on Ctrl-C. Sources are started for you, so they are stopped for you.
on_exit() {
	if [ "$ADMIN_TUNNEL_OWNED" = "1" ]; then
		vm_tunnel_stop admin 2>/dev/null || true
	fi
	if [ "$LAB_OWNED" = "1" ] && [ "$(lab_state)" = "up" ]; then
		printf '\n'
		dim "stopping sources and restoring the firewall..."
		# stderr is NOT redirected. sudo writes its password prompt there, and hiding it
		# turns "type your password" into a console that appears to hang with no
		# explanation — the sudo timestamp can easily have expired during a long session.
		# Warn first if a password is going to be needed, so the prompt is expected.
		if [ "$(id -u)" -ne 0 ] && ! sudo -n true 2>/dev/null; then
			dim "sudo needs your password to restore the firewall:"
		fi
		sudo_run "$LAB_SH" down >/dev/null || \
			err "could not stop the sources — run: sudo $LAB_SH down"
	fi
}

sources_menu() {
	local go
	while true; do
		banner
		head_ "PDE sources"
		dim "  The sources the Evidence Repository collects from. They run continuously;"
		dim "  a capture is a window read against them."
		echo
		local state; state="$(lab_state)"
		local running_ids running_mode running_bank
		running_ids="$(lab_get LAB_WITH_IDS 0)"
		running_mode="$(lab_get LAB_IDS_MODE local)"
		running_bank="$(lab_get LAB_WITH_BANKING 0)"
		# Asked once per draw rather than cached: whether the VM is up is exactly the
		# thing that changes behind this screen's back.
		local vst; vst="$(vm_status)"

		printf '  %s%-16s %-12s %s%s\n' "$C_DIM" "SOURCE" "PRODUCT" "STATUS" "$R"
		if [ "$state" = "up" ]; then
			printf '  %-16s %-12s %s%s%s\n' "firewall" "ufw" "$C_OK" "running" "$R"
			if [ "$running_ids" = "1" ] && [ "$running_mode" = "remote" ]; then
				printf '  %-16s %-12s %s%s%s\n' "ids" "Slips" "$C_OK" "capturing here, analysed on $VM_NAME" "$R"
			elif [ "$running_ids" = "1" ]; then
				printf '  %-16s %-12s %s%s%s\n' "ids" "Slips" "$C_OK" "running locally" "$R"
			else
				printf '  %-16s %-12s %s%s%s\n' "ids" "Slips" "$C_DIM" "disabled" "$R"
			fi
			if [ "$running_bank" = "1" ]; then
				printf '  %-16s %-12s %s%s%s\n' "banking-events" "Fineract" "$C_OK" "running on $VM_NAME" "$R"
				printf '  %-16s %-12s %s%s%s\n' "banking-audit" "Fineract" "$C_OK" "running on $VM_NAME" "$R"
			else
				printf '  %-16s %-12s %s%s%s\n' "banking-events" "Fineract" "$C_DIM" "disabled" "$R"
				printf '  %-16s %-12s %s%s%s\n' "banking-audit" "Fineract" "$C_DIM" "disabled" "$R"
			fi
		else
			local s
			for s in "firewall ufw" "ids Slips" "banking-events Fineract" "banking-audit Fineract"; do
				printf '  %-16s %-12s %s%s%s\n' "${s%% *}" "${s#* }" "$C_DIM" "stopped" "$R"
			done
		fi
		printf '  %-16s %-12s %s%s%s\n' "auth" "Keycloak" "$C_DIM" "not built yet" "$R"
		echo
		case "$vst" in
			RUNNING) printf '  %s\n' "${C_DIM}research VM${R}  ${C_OK}$VM_NAME running${R}" ;;
			"")      printf '  %s\n' "${C_DIM}research VM${R}  ${C_ERR}cannot be queried${R} ${C_DIM}— Remote/install-gcloud.sh${R}" ;;
			*)       printf '  %s\n' "${C_DIM}research VM${R}  ${C_WARN}$VM_NAME $vst${R} ${C_DIM}— the bank and a VM-side IDS need it running${R}" ;;
		esac
		if [ "$WITH_BANKING" = "1" ] && [ ! -r "$BANK_SEED" ]; then
			warn "The bank has not been seeded — option s, with the VM running."
		fi

		echo
		dim "  The firewall is the base source — it owns the topology the traffic runs"
		dim "  on, so it cannot be turned off on its own."
		echo
		# The labels name what pressing them does, rather than showing a state and leaving
		# the reader to work out which way it will move. "setting", not "it": the table
		# above reports what is *running*, and with the sources stopped the two differ.
		if [ "$WITH_IDS" = "1" ]; then
			printf '  %s1%s  Turn the IDS source OFF      %s(setting: on)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		else
			printf '  %s1%s  Turn the IDS source ON       %s(setting: off)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		fi
		if [ "$IDS_REMOTE" = "1" ]; then
			printf '  %s4%s  Run the IDS locally instead  %s(setting: analysed on the VM)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		else
			printf '  %s4%s  Run the IDS on the VM        %s(setting: local Slips in Docker)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		fi
		if [ "$WITH_BANKING" = "1" ]; then
			printf '  %s5%s  Turn the banking source OFF  %s(setting: on)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		else
			printf '  %s5%s  Turn the banking source ON   %s(setting: off)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		fi

		# Setting and reality can disagree, because every source here attaches when the
		# sources start and cannot join or leave ones that are already running.
		if [ "$state" = "up" ]; then
			local want_mode; want_mode="$([ "$IDS_REMOTE" = "1" ] && echo remote || echo local)"
			if [ "$running_ids" != "$WITH_IDS" ] || [ "$running_bank" != "$WITH_BANKING" ] \
				|| { [ "$WITH_IDS" = "1" ] && [ "$running_mode" != "$want_mode" ]; }; then
				echo
				warn "Changed, but not yet applied."
				dim "    Sources attach when they start, so the running ones still have the old"
				dim "    settings. Option 2 restarts them, which is what applies the change."
			fi
		fi

		echo
		case "$state" in
			up)
				printf '  %s2%s  Restart sources              %s(what applies a change made above)%s\n' \
					"$C_NUM" "$R" "$C_DIM" "$R"
				# Naming the values it returns to, rather than "restores your firewall".
				printf '  %s3%s  Stop sources                 %s(ufw back to ENABLED=%s LOGLEVEL=%s)%s\n' \
					"$C_NUM" "$R" "$C_DIM" "$(lab_get LAB_ORIG_ENABLED)" "$(lab_get LAB_ORIG_LOGLEVEL)" "$R"
				;;
			stale) printf '  %s2%s  %sRecover stale session%s     %s(put the firewall back)%s\n' "$C_NUM" "$R" "$C_ERR" "$R" "$C_DIM" "$R" ;;
			*)     printf '  %s2%s  Start sources\n' "$C_NUM" "$R" ;;
		esac
		echo
		printf '  %ss%s  Seed the bank                %s(first time, or after its database is wiped)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		if [ "$vst" = "RUNNING" ]; then
			printf '  %sv%s  Stop the research VM         %s(only its disk is billed while stopped)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		else
			printf '  %sv%s  Start the research VM        %s(~4 min: VM, then Fineract and the repository)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		fi
		echo
		printf '  %s0%s  back\n' "$C_NUM" "$R"
		echo
		printf '  %sselect>%s ' "$C_TITLE" "$R"; read -r go

		local changed=0
		case "$go" in
			1) if [ "$WITH_IDS" = "1" ]; then WITH_IDS=0; else WITH_IDS=1; fi
			   persist WITH_IDS; changed=1 ;;
			4) if [ "$IDS_REMOTE" = "1" ]; then IDS_REMOTE=0; else IDS_REMOTE=1; fi
			   persist IDS_REMOTE; [ "$WITH_IDS" = "1" ] && changed=1 ;;
			5) if [ "$WITH_BANKING" = "1" ]; then WITH_BANKING=0; else WITH_BANKING=1; fi
			   persist WITH_BANKING; changed=1 ;;
			2)
				case "$state" in
					up)    echo; lab_take_down && lab_bring_up; pause ;;
					stale) echo; sudo_run "$LAB_SH" down; pause ;;
					*)     echo; lab_bring_up; pause ;;
				esac ;;
			3) [ "$state" = "up" ] && { echo; lab_take_down; pause; } ;;
			s|S)
				echo
				if [ "$vst" != "RUNNING" ]; then
					err "the research VM is not running — option v first"
				else
					# The seeding script is idempotent: everything is found by a stable key
					# before it is created, so running it again is always safe.
					"$VM_SH" seed 2>&1 | sed 's/^/  /' && ok "the bank is ready for banking windows"
					ADMIN_TUNNEL_OWNED=1
				fi
				pause ;;
			v|V)
				echo
				if [ "$vst" = "RUNNING" ]; then
					if [ "$state" = "up" ] && { [ "$running_bank" = "1" ] || [ "$running_mode" = "remote" ]; }; then
						err "the running sources use the VM — stop them first (option 3)"
					else
						printf '  %sstop %s? [y/N]>%s ' "$C_TITLE" "$VM_NAME" "$R"
						local yn; if read -r yn && [ "$yn" = "y" -o "$yn" = "Y" ]; then
							"$VM_SH" stop 2>&1 | sed 's/^/  /'
							ADMIN_TUNNEL_OWNED=0
						fi
					fi
				else
					"$VM_SH" start 2>&1 | sed 's/^/  /'
				fi
				pause ;;
			0|q) return ;;
			*) ;;
		esac

		# Offer the restart here instead of leaving a warning to act on separately: a
		# toggle alone does nothing to running sources.
		if [ "$changed" = "1" ] && [ "$state" = "up" ]; then
			echo
			printf '  %sapply it now? this restarts the sources [y/N]>%s ' "$C_TITLE" "$R"
			# EOF is not consent — see the stale-recovery prompt.
			local apply
			if read -r apply; then
				case "$apply" in
					y|Y) echo; lab_take_down && lab_bring_up; pause ;;
					*)   dim "  left for option 2"; sleep 1 ;;
				esac
			fi
		fi
	done
}

help_menu() {
	while true; do
		banner
		head_ "Help and diagnostics"
		echo
		printf '  %s1%s  How firewall evidence works %s(log anatomy, why it is real)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		printf '  %s2%s  Environment check           %s(can this machine capture at all)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		echo
		printf '  %s0%s  back\n' "$C_NUM" "$R"
		echo
		printf '  %sselect>%s ' "$C_TITLE" "$R"; read -r a
		case "$a" in
			1) explain ;;
			2) doctor ;;
			0|q) return ;;
			*) ;;
		esac
	done
}

# ---- main menu -----------------------------------------------
main_menu() {
	while true; do
		banner
		local labs; labs="$(lab_state)"
		case "$labs" in
			up)    printf '  %s1%s  PDE sources              %s(running — view, enable, disable)%s\n' "$C_NUM" "$R" "$C_DIM" "$R" ;;
			stale) printf '  %s1%s  PDE sources              %s%s%s\n' "$C_NUM" "$R" "$C_ERR" "(stale session — needs recovery)" "$R" ;;
			*)     printf '  %s1%s  PDE sources              %s(stopped — view, enable, start)%s\n' "$C_NUM" "$R" "$C_DIM" "$R" ;;
		esac
		if [ "$labs" = "up" ]; then
			printf '  %s2%s  Capture a window         %s(against the running lab)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		else
			printf '  %s2%s  Capture a window         %s(one-shot: builds and restores its own)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		fi
		echo
		printf '  %s3%s  Choose attack profile    %s%s%s\n' "$C_NUM" "$R" "$C_KEY" "$ATTACK_PROFILE" "$R"
		printf '  %s4%s  Configure the scenario   %s%s users, %ss, %s%% malicious%s\n' "$C_NUM" "$R" "$C_DIM" "$USERS" "$DURATION" "$MALICIOUS_PCT" "$R"
		echo
		printf '  %s5%s  Preview firewall changes %s(dry run, nothing applied)%s\n'   "$C_NUM" "$R" "$C_DIM" "$R"
		printf '  %s6%s  Preview the event plan   %s(port histogram, no packets)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		echo
		printf '  %s7%s  Read evidence back\n' "$C_NUM" "$R"
		printf '  %s8%s  Verify integrity         %s(sha256 against the manifest)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		printf '  %ss%s  Submit to the repository %s(one source at a time)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		echo
		printf '  %s9%s  Help and diagnostics\n' "$C_NUM" "$R"
		echo
		printf '  %s0%s  Quit\n' "$C_NUM" "$R"
		echo
		printf '  %sselect>%s ' "$C_TITLE" "$R"; read -r choice || return

		case "$choice" in
			1) sources_menu ;;
			2) run_capture ;;
			3) profile_menu ;;
			4) configure_menu ;;
			5) preview_firewall ;;
			6) preview_plan ;;
			7) view_evidence ;;
			8) verify_evidence ;;
			s|S) submit_evidence ;;
			9) help_menu ;;
			0|q|Q) clear; return ;;
			*) ;;
		esac
	done
}

# ---- arguments -----------------------------------------------
AUTO_LAB=1
while [ $# -gt 0 ]; do
	case "$1" in
		# For reading evidence back without touching the firewall or asking for sudo.
		--no-lab) AUTO_LAB=0; shift ;;
		-h|--help)
			echo "usage: pde [--no-lab]"
			echo "  --no-lab   do not start the PDE sources on launch (read-only use)"
			exit 0 ;;
		*) err "unknown option '$1'"; exit 2 ;;
	esac
done

# ---- preflight -----------------------------------------------
if [ ! -x "$FW_SCRIPT" ]; then
	err "simulator not found or not executable: $FW_SCRIPT"
	dim "  chmod +x \"$FW_SCRIPT\" \"$FW_GEN\" \"$LAB_SH\""
	exit 1
fi
[ -x "$LAB_SH" ] || { err "lab.sh not found or not executable: $LAB_SH"; exit 1; }
command -v python3 >/dev/null 2>&1 || { err "python3 not found on PATH"; exit 1; }
command -v ufw     >/dev/null 2>&1 || warn "ufw not found — capturing will fail, everything else works"

# Quitting, Ctrl-C, or the shell going away all land on the same teardown. INT is
# re-raised as an exit so the EXIT handler runs exactly once either way.
trap on_exit EXIT
trap 'exit 130' INT TERM

# ---- start the sources ---------------------------------------
case "$(lab_state)" in
	stale)
		clear
		err "A previous session did not shut down cleanly."
		dim "  Its namespace is gone, but ufw.service is enabled — your firewall has most"
		dim "  likely come back up still carrying the test rules from that session."
		echo
		if [ "$AUTO_LAB" = "0" ]; then
			# --no-lab is a promise not to touch the firewall or ask for sudo. Reporting
			# the stale session is useful; reaching for root behind that flag is not.
			dim "  --no-lab, so nothing has been changed. Recover when you are ready with:"
			dim "    sudo $LAB_SH down"
			sleep 2
		else
			printf '  %srestore the firewall now? [Y/n]>%s ' "$C_TITLE" "$R"
			# `read` failing means EOF, not consent. Letting an empty variable fall
			# through to the default would run a privileged command on nobody's say-so
			# — which, piped, hangs forever on a sudo password prompt that has no
			# terminal to answer it.
			if read -r _r; then
				case "$_r" in
					n|N) dim "  left as is — option 1 can recover it later" ;;
					*)   sudo_run "$LAB_SH" down || err "recovery failed; run: sudo $LAB_SH down" ;;
				esac
			else
				dim "  no input — left as is. Recover with: sudo $LAB_SH down"
			fi
		fi
		echo
		;;
	up)
		# Someone else's session. Report it and leave it alone — tearing down something
		# this console did not start would restore a firewall out from under them.
		clear
		warn "PDE sources are already running from an earlier session."
		dim "  Leaving them as they are; this console will not stop them on exit."
		sleep 2
		;;
esac

if [ "$AUTO_LAB" = "1" ] && [ "$(lab_state)" = "down" ]; then
	clear
	rule
	printf '%s  PDE SOURCE CONSOLE%s\n' "$C_TITLE" "$R"
	rule
	head_ "Starting the PDE sources"
	dim "  The sources run for as long as this console does, and are stopped when you"
	dim "  quit. Your firewall is restored at that point."
	echo
	kv "firewall" "ufw — topology, rules and full logging"
	if [ "$WITH_IDS" = "1" ] && [ "$IDS_REMOTE" = "1" ]; then
		kv "ids" "tcpdump on the veth; Slips analyses each window on $VM_NAME"
	elif [ "$WITH_IDS" = "1" ]; then
		kv "ids" "Slips on the veth (~50s of startup)"
	else
		kv "ids" "disabled — option 1 enables it"
	fi
	if [ "$WITH_BANKING" = "1" ]; then
		kv "banking" "tunnel $HOST_IP:$BANK_PORT to Fineract on $VM_NAME"
	else
		kv "banking" "disabled — option 1 enables it"
	fi
	echo
	if ! lab_bring_up; then
		echo
		err "could not start the sources."
		dim "  The console still runs; captured evidence can be read back, and option 1"
		dim "  will retry. Use --no-lab to skip this on launch."
		pause
	fi
fi

main_menu
