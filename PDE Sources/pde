#!/usr/bin/env bash
# ==============================================================
#  PDE SOURCE CONSOLE
#
#  Interactive front end for the Potential Digital Evidence
#  simulators: configure a scenario, choose how the attacker
#  behaves, capture a window, and read the evidence back.
#
#  The simulators themselves stay flag-driven and scriptable —
#  this console drives them, it does not replace them.
#
#  Usage:  bash "PDE Sources/pde"
# ==============================================================
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FW_DIR="$SCRIPT_DIR/Firewall"
FW_SCRIPT="$FW_DIR/simulate-firewall.sh"
FW_GEN="$FW_DIR/generate_traffic.py"
LAB_SH="$SCRIPT_DIR/lab.sh"
# Honours a LAB_DIR override the same way lab-config.sh does, so tests can point the
# whole lifecycle at a scratch directory instead of the real session state — which holds
# a live backup of the machine's firewall rules and must never be a test fixture.
LAB_STATE_FILE="${LAB_DIR:-$SCRIPT_DIR/.lab}/state.env"
CONFIG_FILE="${PDE_CONFIG:-$SCRIPT_DIR/pde.conf}"

# ---- scenario defaults ---------------------------------------
USERS=10
DURATION=30
RATE=20
MALICIOUS_PCT=10
MALICIOUS_USERS=1
ATTACK_PROFILE=port-scan
SEED=1337
OUTDIR="$SCRIPT_DIR/output"

# IDS correlation: run Slips on the veth during the window so the firewall and the
# IDS produce independent evidence for the same packets.
WITH_IDS=0
IDS_DRAIN=45

[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

# ---- palette -------------------------------------------------
# Matches Anomaly Detection/Scripts/slips-cli.sh so the two consoles read as
# one product rather than two tools that happen to share a repo.
C_TITLE=$'\033[1;38;5;74m'
C_DIM=$'\033[38;5;244m'
C_OK=$'\033[38;5;72m'
C_WARN=$'\033[38;5;179m'
C_ERR=$'\033[38;5;167m'
C_KEY=$'\033[38;5;179m'
C_NUM=$'\033[1;38;5;110m'
C_RULE=$'\033[38;5;238m'
R=$'\033[0m'

rule() { printf '%s%s%s\n' "$C_RULE" "──────────────────────────────────────────────────────────────" "$R"; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$R"; }
ok()   { printf '  %s✓%s %s\n' "$C_OK" "$R" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_WARN" "$R" "$*"; }
err()  { printf '  %s✗%s %s\n' "$C_ERR" "$R" "$*"; }
head_(){ printf '\n%s%s%s\n' "$C_TITLE" "$*" "$R"; }
pause(){ printf '\n%s  press enter to continue%s' "$C_DIM" "$R"; read -r _; }
kv()   { printf '    %s%-28s%s %s\n' "$C_DIM" "$1" "$R" "$2"; }

# ---- state ---------------------------------------------------
# down  — nothing running, the host is untouched
# up    — infrastructure standing; captures run against it
# stale — a session was recorded but its namespace is gone (reboot). The firewall may
#         still be carrying the test rules, and nothing is running that would undo it.
lab_state() {
	[ -f "$LAB_STATE_FILE" ] || { echo down; return; }
	# Via lab_field, not a private grep: values are quoted, and reading LAB_NS as
	# `"pde-fw"` fails to match the namespace and reports a live lab as stale.
	local ns; ns="$(lab_field LAB_NS)"
	if ip netns list 2>/dev/null | awk '{print $1}' | grep -qx "${ns:-pde-fw}"; then
		echo up
	else
		echo stale
	fi
}
# Values in the state file are quoted, so strip the surrounding quotes rather than
# printing them back to the user.
lab_field() {
	grep -E "^$1=" "$LAB_STATE_FILE" 2>/dev/null | cut -d= -f2- | sed 's/^"//; s/"$//'
}

ufw_enabled()  { grep -E '^ENABLED='  /etc/ufw/ufw.conf 2>/dev/null | cut -d= -f2; }
ufw_loglevel() { grep -E '^LOGLEVEL=' /etc/ufw/ufw.conf 2>/dev/null | cut -d= -f2; }
rsyslog_up()   { pgrep -x rsyslogd >/dev/null 2>&1; }

# `grep -c` prints 0 *and* exits 1 with no matches, so `grep -c ... || echo 0`
# emits "0\n0" and shifts every later printf argument. Count into a variable.
run_count() {
	local n=0
	[ -d "$OUTDIR" ] && n=$(find "$OUTDIR" -maxdepth 1 -name 'firewall_*.manifest.json' 2>/dev/null | wc -l)
	printf '%s' "${n:-0}"
}

latest_run() {
	[ -d "$OUTDIR" ] || return 1
	local f
	f=$(find "$OUTDIR" -maxdepth 1 -name 'firewall_*.manifest.json' 2>/dev/null | sort | tail -1)
	[ -n "$f" ] || return 1
	basename "$f" | sed -e 's/^firewall_//' -e 's/\.manifest\.json$//'
}

# Reads one value out of a run's manifest. The expression is evaluated against
# `m`, the parsed manifest.
manifest_field() {
	python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); print(eval(sys.argv[2]))' \
		"$OUTDIR/firewall_$1.manifest.json" "$2" 2>/dev/null
}

# ---- status banner -------------------------------------------
banner() {
	clear
	rule
	printf '%s  PDE SOURCE CONSOLE%s\n' "$C_TITLE" "$R"
	rule

	local lab; lab="$(lab_state)"
	case "$lab" in
		up)    printf '  %s\n' "${C_OK}● LAB UP${R}  ${C_DIM}since $(lab_field LAB_STARTED_UTC)   ufw carrying test rules   $([ "$(lab_field LAB_WITH_IDS)" = "1" ] && echo "slips running" || echo "no ids")${R}" ;;
		stale) printf '  %s\n' "${C_ERR}● LAB STALE${R}  ${C_DIM}session did not survive; your firewall may still be modified — option 1 to recover${R}" ;;
		*)     printf '  %s\n' "${C_DIM}○ lab down   the host is untouched${R}" ;;
	esac

	local fw rs en
	en="$(ufw_enabled)"
	if [ "$en" = "yes" ]; then fw="${C_WARN}active${R}"; else fw="${C_DIM}inactive${R}"; fi
	if rsyslog_up; then rs="${C_OK}running${R}"; else rs="${C_ERR}stopped${R}"; fi
	printf '  %sufw%s %-22b %srsyslog%s %-22b %sloglevel%s %s\n' \
		"$C_DIM" "$R" "$fw" "$C_DIM" "$R" "$rs" "$C_DIM" "$R" "$(ufw_loglevel)"

	# Assembled as single strings then printed with one %s each, so an argument
	# count can never drift out of step with the format.
	printf '  %s\n' "${C_DIM}users${R} ${C_KEY}${USERS}${R} ${C_DIM}(${MALICIOUS_USERS} attacking)${R}   ${C_DIM}window${R} ${C_KEY}${DURATION}s${R}   ${C_DIM}rate${R} ${C_KEY}${RATE}/s${R}   ${C_DIM}malicious${R} ${C_KEY}${MALICIOUS_PCT}%${R}"
	local sources
	if [ "$WITH_IDS" = "1" ]; then
		sources="${C_KEY}firewall${R} ${C_DIM}+${R} ${C_KEY}ids${R}"
	else
		sources="${C_KEY}firewall${R} ${C_DIM}only${R}"
	fi
	printf '  %s\n' "${C_DIM}profile${R} ${C_KEY}${ATTACK_PROFILE}${R}   ${C_DIM}seed${R} ${C_KEY}${SEED}${R}   ${C_DIM}sources${R} ${sources}"

	local n; n="$(run_count)"
	if [ "${n:-0}" -gt 0 ]; then
		local last lines blocked
		last="$(latest_run)"
		lines="$(manifest_field "$last" 'm["output"]["lines"]')"
		blocked="$(manifest_field "$last" 'm["output"]["ufw_block_lines"]')"
		printf '  %s\n' "${C_DIM}captured${R} ${C_KEY}${n}${R}   ${C_DIM}latest${R} ${C_KEY}${last}${R} ${C_DIM}(${lines:-?} lines, ${C_ERR}${blocked:-?} BLOCK${C_DIM})${R}"
	else
		printf '  %s\n' "${C_DIM}captured${R} ${C_DIM}nothing yet${R}"
	fi
	rule
}

# ---- profile catalogue ---------------------------------------
# Short signature lines rather than shelling to the generator on every redraw:
# the menu has to stay instant, and this is what the log actually shows.
profile_signature() {
	case "$1" in
		port-scan)   printf 'one SRC, many different DPTs — a wide BLOCK fan-out' ;;
		brute-force) printf 'one SRC, one DPT, many SPTs — repeated BLOCKs on 22' ;;
		db-probe)    printf 'database ports only — narrow and deliberate' ;;
		stealth)     printf 'evenly spaced, maximal gaps — slips rate thresholds' ;;
		syn-burst)   printf 'every attempt in one short spike against one port' ;;
		mixed)       printf 'sweep first, then pressure on a single port' ;;
		*)           printf 'unknown profile' ;;
	esac
}

profile_menu() {
	local names="port-scan brute-force db-probe stealth syn-burst mixed"
	while true; do
		banner
		head_ "Choose how the attacker behaves"
		dim "  A firewall log has no 'malicious' column — only a source, a destination"
		dim "  port and a verdict. An attack is therefore only ever a shape."
		echo
		local i=1 p mark
		for p in $names; do
			if [ "$p" = "$ATTACK_PROFILE" ]; then mark="${C_OK}◂ selected${R}"; else mark=""; fi
			printf '  %s%s%s  %-13s %s%-46s%s %b\n' "$C_NUM" "$i" "$R" "$p" \
				"$C_DIM" "$(profile_signature "$p")" "$R" "$mark"
			i=$((i + 1))
		done
		echo
		printf '  %s7%s  Preview this profile %s(port histogram, no packets sent)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		echo
		printf '  %s0%s  back\n' "$C_NUM" "$R"
		echo
		printf '  %sselect>%s ' "$C_TITLE" "$R"; read -r a

		case "$a" in
			1) ATTACK_PROFILE=port-scan;   persist ATTACK_PROFILE ;;
			2) ATTACK_PROFILE=brute-force; persist ATTACK_PROFILE ;;
			3) ATTACK_PROFILE=db-probe;    persist ATTACK_PROFILE ;;
			4) ATTACK_PROFILE=stealth;     persist ATTACK_PROFILE ;;
			5) ATTACK_PROFILE=syn-burst;   persist ATTACK_PROFILE ;;
			6) ATTACK_PROFILE=mixed;       persist ATTACK_PROFILE ;;
			7) preview_plan ;;
			0|q) return ;;
			*) ;;
		esac
	done
}

# ---- configuration -------------------------------------------
persist() {
	local key="$1" value="${!1}"
	touch "$CONFIG_FILE" 2>/dev/null || return 0
	if grep -qE "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
		sed -i "s|^${key}=.*|${key}=${value}|" "$CONFIG_FILE"
	else
		printf '%s=%s\n' "$key" "$value" >> "$CONFIG_FILE"
	fi
}

ask_number() {
	local var="$1" prompt="$2" hint="$3" current="${!1}" reply
	printf '\n  %s%s%s\n' "$C_TITLE" "$prompt" "$R"
	dim "  $hint"
	printf '  %scurrent%s %s%s%s   %snew value (enter to keep)>%s ' \
		"$C_DIM" "$R" "$C_KEY" "$current" "$R" "$C_DIM" "$R"
	read -r reply
	[ -z "$reply" ] && return
	case "$reply" in
		*[!0-9.]*|'') err "not a number — keeping $current"; sleep 1; return ;;
	esac
	printf -v "$var" '%s' "$reply"
	persist "$var"
}

configure_menu() {
	while true; do
		banner
		head_ "Scenario configuration"
		dim "  Saved to pde.conf and passed to the simulator on every run."
		echo
		printf '  %s1%s  Users            %s%-7s%s %sone source IP each; a user in a firewall log IS an IP%s\n' "$C_NUM" "$R" "$C_KEY" "$USERS" "$R" "$C_DIM" "$R"
		printf '  %s2%s  Duration         %s%-7s%s %sseconds captured — this is the EvidenceItem window%s\n'    "$C_NUM" "$R" "$C_KEY" "${DURATION}s" "$R" "$C_DIM" "$R"
		printf '  %s3%s  Rate             %s%-7s%s %sattempts per second, all users combined%s\n'               "$C_NUM" "$R" "$C_KEY" "${RATE}/s" "$R" "$C_DIM" "$R"
		printf '  %s4%s  Malicious share  %s%-7s%s %spercentage of EVENTS that are malicious%s\n'               "$C_NUM" "$R" "$C_KEY" "${MALICIOUS_PCT}%" "$R" "$C_DIM" "$R"
		printf '  %s5%s  Attackers        %s%-7s%s %show many USERS attack — a separate knob from 4%s\n'        "$C_NUM" "$R" "$C_KEY" "$MALICIOUS_USERS" "$R" "$C_DIM" "$R"
		printf '  %s6%s  Seed             %s%-7s%s %ssame seed, same run — keep it for reproducibility%s\n'     "$C_NUM" "$R" "$C_KEY" "$SEED" "$R" "$C_DIM" "$R"
		echo
		echo
		local ids_state
		if [ "$WITH_IDS" = "1" ]; then ids_state="${C_OK}on${R}"; else ids_state="${C_DIM}off${R}"; fi
		printf '  %s7%s  IDS correlation  %-16b %sSlips sniffs the veth during the window%s\n' "$C_NUM" "$R" "$ids_state" "$C_DIM" "$R"
		if [ "$WITH_IDS" = "1" ]; then
			printf '  %s8%s  IDS drain        %s%-6s%s %sseconds kept running past the window to raise evidence%s\n' "$C_NUM" "$R" "$C_KEY" "${IDS_DRAIN}s" "$R" "$C_DIM" "$R"
		fi
		echo
		local total mal
		total=$(awk "BEGIN{printf \"%d\", $DURATION * $RATE}")
		mal=$(awk "BEGIN{printf \"%d\", $DURATION * $RATE * $MALICIOUS_PCT / 100}")
		printf '  %s\n' "${C_DIM}this scenario produces${R} ${C_KEY}${total}${R} ${C_DIM}events, of which${R} ${C_KEY}${mal}${R} ${C_DIM}are malicious${R}"
		echo
		printf '  %s0%s  back\n' "$C_NUM" "$R"
		echo
		printf '  %sselect>%s ' "$C_TITLE" "$R"; read -r a

		case "$a" in
			1) ask_number USERS           "Number of simulated users" "the brief says 10" ;;
			2) ask_number DURATION        "Capture window in seconds" "the brief says 30" ;;
			3) ask_number RATE            "Events per second"         "20 gives 600 events across a 30s window" ;;
			4) ask_number MALICIOUS_PCT   "Malicious share of events" "the brief says 10%" ;;
			5) ask_number MALICIOUS_USERS "How many users attack"     "1 of 10. Note 10:1 users is 9.09%, not 10% — these are different claims" ;;
			6) ask_number SEED            "Random seed"               "any integer; the whole run is reproducible from it" ;;
			7) if [ "$WITH_IDS" = "1" ]; then WITH_IDS=0; else WITH_IDS=1; fi; persist WITH_IDS ;;
			8) [ "$WITH_IDS" = "1" ] && ask_number IDS_DRAIN "Seconds to drain Slips after the window" \
					"Slips raises evidence in batches; collecting immediately gets an empty file" ;;
			0|q) return ;;
			*) ;;
		esac
	done
}

# ---- preview -------------------------------------------------
preview_plan() {
	banner
	head_ "Event plan for '$ATTACK_PROFILE'"
	dim "  Built from seed $SEED. No packets are sent and nothing is changed."
	echo
	local ips="" mal="" i
	for i in $(seq 1 "$USERS"); do ips="${ips}${ips:+,}10.99.0.$((10 + i))"; done
	for i in $(seq 0 $((MALICIOUS_USERS - 1))); do mal="${mal}${mal:+,}10.99.0.$((10 + USERS - i))"; done

	python3 "$FW_GEN" --plan-only \
		--users "$ips" --malicious-users "$mal" --target 10.99.0.1 \
		--duration "$DURATION" --rate "$RATE" --malicious-pct "$MALICIOUS_PCT" \
		--attack-profile "$ATTACK_PROFILE" \
		--benign-ports 80,443,8080 \
		--malicious-ports 21,22,23,135,139,445,1433,3306,3389,5432,5900,6379,9200,27017 \
		--seed "$SEED" --out /dev/null 2>&1 \
	| python3 -c 'import json,sys
d = json.load(sys.stdin)
print("    %-20s %s" % ("planned events", d["planned_events"]))
print("    %-20s %s" % ("malicious", d["malicious_events"]))
print("    %-20s %s" % ("benign", d["benign_events"]))
h = d["malicious_port_histogram"]
if h:
    print()
    print("    malicious attempts by destination port:")
    top = max(h.values())
    for p, n in sorted(h.items(), key=lambda kv: -kv[1]):
        print("      %-7s %-4s %s" % (p, n, "#" * max(1, int(n * 34 / top))))'
	echo
	dim "  This shape is all detection has to work with. Worth comparing profiles"
	dim "  before committing to one for the dataset."
	pause
}

preview_firewall() {
	banner
	head_ "What a run would change"
	dim "  Nothing below has been applied — this is the dry run."
	echo
	"$FW_SCRIPT" --dry-run --users "$USERS" --duration "$DURATION" \
		--malicious-pct "$MALICIOUS_PCT" --malicious-users "$MALICIOUS_USERS" \
		--attack-profile "$ATTACK_PROFILE" 2>&1 | sed 's/^/  /'
	pause
}

# ---- capture -------------------------------------------------
run_capture() {
	banner
	head_ "Capture a window"
	dim "  Real packets cross the real INPUT chain, and the log lines are written by"
	dim "  the kernel rather than by us. Only the scenario is synthetic."
	echo
	if [ "$WITH_IDS" = "1" ]; then
		kv "sources" "firewall (ufw) + ids (Slips)"
	else
		kv "sources" "firewall (ufw)"
	fi
	kv "users"     "$USERS ($MALICIOUS_USERS attacking)"
	kv "window"    "${DURATION}s at ${RATE}/s"
	kv "profile"   "$ATTACK_PROFILE"
	kv ""          "$(profile_signature "$ATTACK_PROFILE")"
	kv "malicious" "${MALICIOUS_PCT}% of events"
	echo
	if [ "$WITH_IDS" = "1" ]; then
		dim "    Slips attaches to the veth before the window opens and keeps running"
		dim "    ${IDS_DRAIN}s past it, so both sources describe the same packets. Expect roughly"
		dim "    $(( 60 + DURATION + IDS_DRAIN ))s in total — most of it Slips loading its modules."
		echo
	fi
	warn "This enables ufw and modifies the host firewall for ${DURATION}s."
	dim "    Your ruleset, ENABLED and LOGLEVEL are snapshotted and restored on exit,"
	dim "    including on Ctrl-C. Option 4 shows the exact changes first."
	if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
		local c; c=$(docker ps -q 2>/dev/null | wc -l)
		[ "${c:-0}" -gt 0 ] && dim "    ${c} container(s) running; ufw sets FORWARD to DROP while it is active."
	fi
	echo
	printf '  %sproceed? [y/N]>%s ' "$C_TITLE" "$R"; read -r go
	case "$go" in
		y|Y) ;;
		*) dim "  cancelled"; pause; return ;;
	esac

	echo
	local args=(--users "$USERS" --duration "$DURATION" --rate "$RATE"
		--malicious-pct "$MALICIOUS_PCT" --malicious-users "$MALICIOUS_USERS"
		--attack-profile "$ATTACK_PROFILE" --seed "$SEED" --outdir "$OUTDIR")
	if [ "$WITH_IDS" = "1" ]; then
		args+=(--with-ids --ids-drain "$IDS_DRAIN")
	fi

	local rc=0
	if [ "$(id -u)" -ne 0 ]; then
		sudo "$FW_SCRIPT" "${args[@]}" || rc=$?
	else
		"$FW_SCRIPT" "${args[@]}" || rc=$?
	fi
	echo
	if [ "$rc" -eq 0 ]; then ok "capture complete — option 6 reads it back"
	else err "the simulator exited with status $rc"; fi
	pause
}

# ---- evidence ------------------------------------------------
require_run() {
	if ! latest_run >/dev/null 2>&1; then
		banner
		head_ "Nothing captured yet"
		dim "  Option 1 runs a capture."
		pause
		return 1
	fi
	return 0
}

# Lists runs and returns the chosen id. With only one run it returns that one
# without asking, so the common case stays a single keypress.
pick_run() {
	local runs count
	runs=$(find "$OUTDIR" -maxdepth 1 -name 'firewall_*.manifest.json' 2>/dev/null | sort)
	count=$(printf '%s\n' "$runs" | grep -c . 2>/dev/null)
	if [ "${count:-0}" -le 1 ]; then latest_run; return; fi

	banner
	head_ "Captured runs"
	echo
	local i=1 f id detail
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		id=$(basename "$f" | sed -e 's/^firewall_//' -e 's/\.manifest\.json$//')
		detail=$(manifest_field "$id" 'm["configuration"]["attack_profile"]+"   "+str(m["output"]["lines"])+" lines, "+str(m["output"]["ufw_block_lines"])+" BLOCK"')
		printf '  %s%s%s  %-16s %s%s%s\n' "$C_NUM" "$i" "$R" "$id" "$C_DIM" "$detail" "$R"
		i=$((i + 1))
	done <<< "$runs"
	echo
	printf '  %sselect (enter for latest)>%s ' "$C_TITLE" "$R"; read -r sel
	if [ -z "$sel" ]; then latest_run; return; fi
	local chosen
	chosen=$(printf '%s\n' "$runs" | sed -n "${sel}p")
	if [ -z "$chosen" ]; then latest_run; return; fi
	basename "$chosen" | sed -e 's/^firewall_//' -e 's/\.manifest\.json$//'
}

view_evidence() {
	require_run || return
	local run; run="$(pick_run)"
	[ -n "$run" ] || return
	banner
	head_ "Run $run"
	python3 -c 'import json,sys
m = json.load(open(sys.argv[1]))
s, c, w, o = m["source"], m["configuration"], m["window"], m["output"]
def kv(k, v): print("    %-22s %s" % (k, v))
kv("source", "%s (%s)" % (s["pde_source"], s["version"]))
kv("window", "%s -> %s" % (w["start_utc"], w["end_utc"]))
kv("users", "%s (%s attacking)" % (c["users"], c["malicious_users"]))
kv("profile", c.get("attack_profile", "-"))
kv("seed", c["seed"])
print()
kv("log lines", o["lines"])
kv("  UFW BLOCK", o["ufw_block_lines"])
kv("  UFW ALLOW", o["ufw_allow_lines"])
# At logging full every packet also gets an AUDIT line, so lines will exceed the
# event count. Shown rather than hidden, otherwise the totals look wrong.
kv("  UFW AUDIT", o.get("ufw_audit_lines", "-"))
kv("sha256", o["sha256"][:40] + "...")' "$OUTDIR/firewall_${run}.manifest.json"

	# When the window was captured with --with-ids there is a second, independent
	# account of the same packets. Showing them together is the whole point.
	local group="$OUTDIR/window_${run}.group.json"
	if [ -f "$group" ]; then
		head_ "IDS — same window, independent source"
		python3 -c 'import json,sys
g = json.load(open(sys.argv[1]))
ids = next((i for i in g["items"] if i["pde_source"] == "ids"), None)
def kv(k, v): print("    %-22s %s" % (k, v))
if ids:
    kv("product", ids["product"])
    kv("evidence lines", "%s in window (%s seen in total)"
       % (ids["evidence_lines"], ids["evidence_lines_seen_total"]))
    t = ids["threat_levels"]
    kv("threat levels", "  ".join("%s %s" % (n, t[n]) for n in
        ("critical", "high", "medium", "low", "info")))
    kv("sha256", (ids["sha256"] or "-")[:40] + ("..." if ids["sha256"] else ""))' "$group"

		local ids_log="$OUTDIR/ids_${run}.alerts.log"
		if [ -s "$ids_log" ]; then
			echo
			python3 "$SCRIPT_DIR/../Anomaly Detection/Scripts/slips-format.py" --brief \
				< "$ids_log" 2>/dev/null | head -8 | sed 's/^/    /' \
				|| head -4 "$ids_log" | sed 's/^/    /'
		else
			echo
			dim "    Slips raised nothing inside this window."
		fi
	fi

	head_ "Evidence — first 12 lines"
	sed -e "s/\[UFW BLOCK\]/${C_ERR}[UFW BLOCK]${R}/g" \
		-e "s/\[UFW ALLOW\]/${C_OK}[UFW ALLOW]${R}/g" \
		-e "s/\[UFW AUDIT\]/${C_DIM}[UFW AUDIT]${R}/g" \
		-e "s/\(SRC=[0-9.]*\)/${C_TITLE}\1${R}/g" \
		-e "s/\(DPT=[0-9]*\)/${C_KEY}\1${R}/g" \
		"$OUTDIR/firewall_${run}.log" 2>/dev/null | head -12 | sed 's/^/    /'
	echo
	dim "  full log:  $OUTDIR/firewall_${run}.log"
	dim "  labels:    $OUTDIR/firewall_${run}.groundtruth.json"
	pause
}

verify_evidence() {
	require_run || return
	local run; run="$(pick_run)"
	[ -n "$run" ] || return
	banner
	head_ "Integrity — run $run"
	dim "  The manifest digest was taken before anything else touched the file, which"
	dim "  is the SecureRS rule the Evidence Repository follows on ingest."
	echo
	local recorded actual
	recorded="$(manifest_field "$run" 'm["output"]["sha256"]')"
	actual="$(sha256sum "$OUTDIR/firewall_${run}.log" 2>/dev/null | cut -d' ' -f1)"
	kv "recorded"   "${recorded:-missing}"
	kv "recomputed" "${actual:-missing}"
	echo
	if [ -n "$actual" ] && [ "$recorded" = "$actual" ]; then
		ok "match — unmodified since capture"
	else
		err "MISMATCH — the log has changed since it was captured"
	fi
	pause
}

# ---- teaching ------------------------------------------------
explain() {
	banner
	head_ "What a firewall contributes as evidence"
	dim "  Cheap, high-volume, and strong on reconnaissance. It records WHO connected,"
	dim "  WHAT they reached for, WHEN, and whether it was permitted. It cannot tell"
	dim "  you the payload, the application context, or the identity behind an address"
	dim "  — which is the argument for correlating it with the IDS and authentication"
	dim "  sources over the same window."

	head_ "Anatomy of a ufw log line"
	printf '    %s%s%s\n' "$C_DIM" "Sep  5 19:58:03 host kernel: [8821.443021] [UFW BLOCK] IN=veth-pde-h" "$R"
	printf '    %s%s%s\n' "$C_DIM" "SRC=10.99.0.20 DST=10.99.0.1 PROTO=TCP SPT=51234 DPT=3306 SYN" "$R"
	echo
	kv "Sep  5 19:58:03" "syslog time — no year, no sub-second"
	kv "[8821.443021]"   "kernel uptime — this one does have microseconds"
	kv "[UFW BLOCK]"     "the verdict: BLOCK, ALLOW, AUDIT or LIMIT BLOCK"
	kv "SRC="            "source address — this is what a 'user' is here"
	kv "DPT="            "destination port — what was being reached for"
	kv "SPT="            "source port — a fresh one per attempt"
	kv "SYN"             "TCP flags; SYN alone is an attempt, not a session"

	head_ "Why these logs are real and not generated"
	dim "    The traffic is synthetic — users, window and ratios are all ours to set."
	dim "    The log lines are not: the kernel's netfilter LOG target writes them as"
	dim "    the packets cross the INPUT chain. The format is authentic by"
	dim "    construction, so \"is this really what ufw emits?\" has an answer."

	head_ "The setting that quietly ruins a capture"
	dim "    ufw rate-limits its own LOG rules to 3/min at low, medium and high. A 30s"
	dim "    window would yield about four lines however much traffic you generate."
	dim "    Every run sets logging to full, then restores your previous level."
	pause
}

doctor() {
	banner
	head_ "Environment"
	kv "kernel" "$(uname -r)"
	kv "ufw"    "$(ufw --version 2>/dev/null | head -1 || echo 'not installed')"

	head_ "Can this machine capture ufw logs?"
	if command -v ufw     >/dev/null 2>&1; then ok "ufw installed";      else err "ufw missing — sudo apt install ufw"; fi
	if command -v ip      >/dev/null 2>&1; then ok "iproute2 available"; else err "ip missing"; fi
	if command -v python3 >/dev/null 2>&1; then ok "python3 available";  else err "python3 missing"; fi
	if rsyslog_up; then ok "rsyslogd running"; else err "rsyslogd stopped — sudo systemctl start rsyslog"; fi

	if [ -f /proc/config.gz ] && zcat /proc/config.gz 2>/dev/null | grep -q '^CONFIG_NETFILTER_XT_TARGET_LOG=[my]'; then
		ok "kernel has the netfilter LOG target"
	elif [ -f "/lib/modules/$(uname -r)/kernel/net/netfilter/xt_LOG.ko" ]; then
		ok "kernel has the netfilter LOG target (module present)"
	else
		err "no netfilter LOG target — ufw could filter but never log"
	fi

	mkdir -p "$OUTDIR" 2>/dev/null
	if [ -w "$OUTDIR" ]; then ok "output directory writable"; else err "cannot write to $OUTDIR"; fi

	head_ "Current firewall state"
	kv "ufw enabled"  "$(ufw_enabled)"
	kv "ufw loglevel" "$(ufw_loglevel)"
	[ "$(ufw_loglevel)" != "full" ] && dim "    a run sets this to full, then restores it"
	[ "$(id -u)" -ne 0 ] && dim "    not root — capturing will prompt for sudo"
	if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
		local c; c=$(docker ps -q 2>/dev/null | wc -l)
		[ "${c:-0}" -gt 0 ] && dim "    ${c} container(s) running; ufw sets FORWARD to DROP while active"
	fi
	pause
}

# ---- lab lifecycle -------------------------------------------
sudo_run() {
	if [ "$(id -u)" -ne 0 ]; then sudo "$@"; else "$@"; fi
}

# Set when this console started the sources, so it only tears down what it owns. A lab
# someone else left running is reported and left alone.
LAB_OWNED=0

lab_bring_up() {
	local args=(up --users "$USERS")
	[ "$WITH_IDS" = "1" ] && args+=(--with-ids)
	if sudo_run "$LAB_SH" "${args[@]}"; then
		LAB_OWNED=1
		return 0
	fi
	return 1
}

lab_take_down() {
	sudo_run "$LAB_SH" down && LAB_OWNED=0
}

# Runs on quit and on Ctrl-C. Sources are started for you, so they are stopped for you.
on_exit() {
	if [ "$LAB_OWNED" = "1" ] && [ "$(lab_state)" = "up" ]; then
		printf '\n'
		dim "stopping sources and restoring the firewall..."
		sudo_run "$LAB_SH" down >/dev/null 2>&1 || \
			err "could not stop the sources — run: sudo $LAB_SH down"
	fi
}

sources_menu() {
	local go
	while true; do
		banner
		head_ "PDE sources"
		dim "  The sources the Evidence Repository collects from. They run continuously;"
		dim "  a capture is a window read against them."
		echo
		local state; state="$(lab_state)"
		local running_ids; running_ids="$(lab_field LAB_WITH_IDS)"

		printf '  %s%-12s %-12s %s%s\n' "$C_DIM" "SOURCE" "PRODUCT" "STATUS" "$R"
		if [ "$state" = "up" ]; then
			printf '  %-12s %-12s %s%s%s\n' "firewall" "ufw" "$C_OK" "running" "$R"
			if [ "$running_ids" = "1" ]; then
				printf '  %-12s %-12s %s%s%s\n' "ids" "Slips" "$C_OK" "running" "$R"
			else
				printf '  %-12s %-12s %s%s%s\n' "ids" "Slips" "$C_DIM" "disabled" "$R"
			fi
		else
			printf '  %-12s %-12s %s%s%s\n' "firewall" "ufw" "$C_DIM" "stopped" "$R"
			printf '  %-12s %-12s %s%s%s\n' "ids" "Slips" "$C_DIM" "stopped" "$R"
		fi
		printf '  %-12s %-12s %s%s%s\n' "auth" "Keycloak" "$C_DIM" "not built yet" "$R"

		echo
		dim "  The firewall is the base source — it owns the topology the traffic runs"
		dim "  on, so it cannot be turned off on its own."
		echo
		# The label names what pressing it does, rather than showing a state and leaving
		# the reader to work out which way it will move.
		# "setting", not "it": the table above reports what is *running*, and with the
		# sources stopped the two are different things. Saying "it is on" next to a row
		# reading "stopped" invites exactly that confusion.
		if [ "$WITH_IDS" = "1" ]; then
			printf '  %s1%s  Turn the IDS source OFF  %s(setting: on)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		else
			printf '  %s1%s  Turn the IDS source ON   %s(setting: off)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		fi

		# Setting and reality can disagree, because Slips attaches at start-up and
		# cannot join or leave sources that are already running.
		if [ "$state" = "up" ] && [ "$running_ids" != "$WITH_IDS" ]; then
			echo
			warn "Changed, but not yet applied."
			dim "    Slips attaches when the sources start, so the running ones still have"
			dim "    it $([ "$running_ids" = "1" ] && echo "ON" || echo "OFF"). Option 2 restarts them, which is what applies it."
		fi

		echo
		case "$state" in
			up)
				printf '  %s2%s  Restart sources          %s(what applies a change made above)%s\n' \
					"$C_NUM" "$R" "$C_DIM" "$R"
				# Naming the values it returns to, rather than saying "restores your
				# firewall" and leaving the reader to wonder what that means.
				printf '  %s3%s  Stop sources             %s(ufw back to ENABLED=%s LOGLEVEL=%s)%s\n' \
					"$C_NUM" "$R" "$C_DIM" "$(lab_field LAB_ORIG_ENABLED)" "$(lab_field LAB_ORIG_LOGLEVEL)" "$R"
				;;
			stale) printf '  %s2%s  %sRecover stale session%s %s(put the firewall back)%s\n' "$C_NUM" "$R" "$C_ERR" "$R" "$C_DIM" "$R" ;;
			*)     printf '  %s2%s  Start sources\n' "$C_NUM" "$R" ;;
		esac
		echo
		printf '  %s0%s  back\n' "$C_NUM" "$R"
		echo
		printf '  %sselect>%s ' "$C_TITLE" "$R"; read -r go

		case "$go" in
			1)
				if [ "$WITH_IDS" = "1" ]; then WITH_IDS=0; else WITH_IDS=1; fi
				persist WITH_IDS
				# Offer the restart here instead of leaving a warning to act on
				# separately: the toggle alone does nothing to running sources, and
				# making someone find that out from a notice is a poor way to say it.
				if [ "$state" = "up" ]; then
					echo
					printf '  %sapply it now? this restarts the sources [y/N]>%s ' "$C_TITLE" "$R"
					# EOF is not consent — see the stale-recovery prompt.
					if read -r apply; then
						case "$apply" in
							y|Y) echo; lab_take_down && lab_bring_up; pause ;;
							*)   dim "  left for option 2"; sleep 1 ;;
						esac
					fi
				fi
				;;
			2)
				case "$state" in
					up)    echo; lab_take_down && lab_bring_up; pause ;;
					stale) echo; sudo_run "$LAB_SH" down; pause ;;
					*)     echo; lab_bring_up; pause ;;
				esac ;;
			3) [ "$state" = "up" ] && { echo; lab_take_down; pause; } ;;
			0|q) return ;;
			*) ;;
		esac
	done
}

help_menu() {
	while true; do
		banner
		head_ "Help and diagnostics"
		echo
		printf '  %s1%s  How firewall evidence works %s(log anatomy, why it is real)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		printf '  %s2%s  Environment check           %s(can this machine capture at all)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		echo
		printf '  %s0%s  back\n' "$C_NUM" "$R"
		echo
		printf '  %sselect>%s ' "$C_TITLE" "$R"; read -r a
		case "$a" in
			1) explain ;;
			2) doctor ;;
			0|q) return ;;
			*) ;;
		esac
	done
}

# ---- main menu -----------------------------------------------
main_menu() {
	while true; do
		banner
		local labs; labs="$(lab_state)"
		case "$labs" in
			up)    printf '  %s1%s  PDE sources              %s(running — view, enable, disable)%s\n' "$C_NUM" "$R" "$C_DIM" "$R" ;;
			stale) printf '  %s1%s  PDE sources              %s%s%s\n' "$C_NUM" "$R" "$C_ERR" "(stale session — needs recovery)" "$R" ;;
			*)     printf '  %s1%s  PDE sources              %s(stopped — view, enable, start)%s\n' "$C_NUM" "$R" "$C_DIM" "$R" ;;
		esac
		if [ "$labs" = "up" ]; then
			printf '  %s2%s  Capture a window         %s(against the running lab)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		else
			printf '  %s2%s  Capture a window         %s(one-shot: builds and restores its own)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		fi
		echo
		printf '  %s3%s  Choose attack profile    %s%s%s\n' "$C_NUM" "$R" "$C_KEY" "$ATTACK_PROFILE" "$R"
		printf '  %s4%s  Configure the scenario   %s%s users, %ss, %s%% malicious%s\n' "$C_NUM" "$R" "$C_DIM" "$USERS" "$DURATION" "$MALICIOUS_PCT" "$R"
		echo
		printf '  %s5%s  Preview firewall changes %s(dry run, nothing applied)%s\n'   "$C_NUM" "$R" "$C_DIM" "$R"
		printf '  %s6%s  Preview the event plan   %s(port histogram, no packets)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		echo
		printf '  %s7%s  Read evidence back\n' "$C_NUM" "$R"
		printf '  %s8%s  Verify integrity         %s(sha256 against the manifest)%s\n' "$C_NUM" "$R" "$C_DIM" "$R"
		echo
		printf '  %s9%s  Help and diagnostics\n' "$C_NUM" "$R"
		echo
		printf '  %s0%s  Quit\n' "$C_NUM" "$R"
		echo
		printf '  %sselect>%s ' "$C_TITLE" "$R"; read -r choice || return

		case "$choice" in
			1) sources_menu ;;
			2) run_capture ;;
			3) profile_menu ;;
			4) configure_menu ;;
			5) preview_firewall ;;
			6) preview_plan ;;
			7) view_evidence ;;
			8) verify_evidence ;;
			9) help_menu ;;
			0|q|Q) clear; return ;;
			*) ;;
		esac
	done
}

# ---- arguments -----------------------------------------------
AUTO_LAB=1
while [ $# -gt 0 ]; do
	case "$1" in
		# For reading evidence back without touching the firewall or asking for sudo.
		--no-lab) AUTO_LAB=0; shift ;;
		-h|--help)
			echo "usage: pde [--no-lab]"
			echo "  --no-lab   do not start the PDE sources on launch (read-only use)"
			exit 0 ;;
		*) err "unknown option '$1'"; exit 2 ;;
	esac
done

# ---- preflight -----------------------------------------------
if [ ! -x "$FW_SCRIPT" ]; then
	err "simulator not found or not executable: $FW_SCRIPT"
	dim "  chmod +x \"$FW_SCRIPT\" \"$FW_GEN\" \"$LAB_SH\""
	exit 1
fi
[ -x "$LAB_SH" ] || { err "lab.sh not found or not executable: $LAB_SH"; exit 1; }
command -v python3 >/dev/null 2>&1 || { err "python3 not found on PATH"; exit 1; }
command -v ufw     >/dev/null 2>&1 || warn "ufw not found — capturing will fail, everything else works"

# Quitting, Ctrl-C, or the shell going away all land on the same teardown. INT is
# re-raised as an exit so the EXIT handler runs exactly once either way.
trap on_exit EXIT
trap 'exit 130' INT TERM

# ---- start the sources ---------------------------------------
case "$(lab_state)" in
	stale)
		clear
		err "A previous session did not shut down cleanly."
		dim "  Its namespace is gone, but ufw.service is enabled — your firewall has most"
		dim "  likely come back up still carrying the test rules from that session."
		echo
		printf '  %srestore the firewall now? [Y/n]>%s ' "$C_TITLE" "$R"
		# `read` failing means EOF, not consent. Letting an empty variable fall through
		# to the default would run a privileged command on nobody's say-so — which,
		# piped, hangs forever on a sudo password prompt that has no terminal to
		# answer it.
		if read -r _r; then
			case "$_r" in
				n|N) dim "  left as is — option 1 can recover it later" ;;
				*)   sudo_run "$LAB_SH" down || err "recovery failed; run: sudo $LAB_SH down" ;;
			esac
		else
			dim "  no input — left as is. Recover with: sudo $LAB_SH down"
		fi
		echo
		;;
	up)
		# Someone else's session. Report it and leave it alone — tearing down something
		# this console did not start would restore a firewall out from under them.
		clear
		warn "PDE sources are already running from an earlier session."
		dim "  Leaving them as they are; this console will not stop them on exit."
		sleep 2
		;;
esac

if [ "$AUTO_LAB" = "1" ] && [ "$(lab_state)" = "down" ]; then
	clear
	rule
	printf '%s  PDE SOURCE CONSOLE%s\n' "$C_TITLE" "$R"
	rule
	head_ "Starting the PDE sources"
	dim "  The sources run for as long as this console does, and are stopped when you"
	dim "  quit. Your firewall is restored at that point."
	echo
	kv "firewall" "ufw — topology, rules and full logging"
	if [ "$WITH_IDS" = "1" ]; then
		kv "ids" "Slips on the veth (~50s of startup)"
	else
		kv "ids" "disabled — option 1 enables it"
	fi
	echo
	if ! lab_bring_up; then
		echo
		err "could not start the sources."
		dim "  The console still runs; captured evidence can be read back, and option 1"
		dim "  will retry. Use --no-lab to skip this on launch."
		pause
	fi
fi

main_menu
