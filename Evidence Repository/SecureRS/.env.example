# Copy to .env and adjust. docker-compose.yml has working defaults for every
# value here, so .env is optional -- it exists so you don't have to retype the
# superuser credentials on each fresh volume.
#
#   cp .env.example .env

# --- Published ports -------------------------------------------------------
# Host ports. The container always serves TLS on 443 internally.
HTTPS_PORT=8443
HTTP_PORT=8000

# --- Development escape hatches --------------------------------------------
# Anything other than 0/false/no/off leaves the control ENFORCED.
# ENFORCE_SSL=0 serves plain HTTP on HTTP_PORT and drops the secure-cookie
# flags. ENFORCE_2FA=0 skips the OTP challenge on login and PDE download.
# Both MUST stay at their defaults for anything that isn't local dev.
ENFORCE_SSL=True
ENFORCE_2FA=True

# Must match the port you actually browse to, including the trailing slash.
# Used to build PDE download links in the REST API.
SITE_URL=https://localhost:8443/

# --- Superuser -------------------------------------------------------------
# Created on first start only, and only if all three are set.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
