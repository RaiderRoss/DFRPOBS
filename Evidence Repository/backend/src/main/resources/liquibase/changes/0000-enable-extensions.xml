<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="0000-1" author="dfraas-team">
        <comment>pgcrypto provides gen_random_uuid(), used as the default for all primary keys</comment>
        <sql>CREATE EXTENSION IF NOT EXISTS pgcrypto;</sql>
        <rollback>
            <sql>DROP EXTENSION IF EXISTS pgcrypto;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>