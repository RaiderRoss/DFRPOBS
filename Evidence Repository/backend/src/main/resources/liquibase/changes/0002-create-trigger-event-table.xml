<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="0002-1" author="dfraas-team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="trigger_event"/>
            </not>
        </preConditions>
        <comment>Creates trigger_event — the SIEM/IDS alert that caused an ingestion</comment>
        <createTable tableName="trigger_event">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!--
                The identifier the SOURCE assigned to this alert. This, not `id`, is what
                the ingestion consumer dedupes on: `id` is generated by us at insert time,
                so it is a fresh value on every redelivery and could never match.
            -->
            <column name="external_event_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="source_system" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!--
                Deliberately VARCHAR and not a native enum. Detection rule names are
                vendor-defined and open-ended; a new SIEM rule must not require a
                migration. Contrast EvidenceStatus, where a closed set is the point.
            -->
            <column name="trigger_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- When the SOURCE says the alert fired. Reported by the sender, so it is
                 subject to that host's clock, and is not trustworthy on its own. -->
            <column name="fired_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <!-- When WE received it, stamped by the database clock. This is the one that
                 is defensible in an audit; keep both and never conflate them. -->
            <column name="received_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>

            <!--
                The original alert, byte for byte, plus its digest. The trigger event is
                itself part of the evidentiary record: paraphrasing it into typed columns
                and discarding the original loses the thing an investigator would want to
                examine. Kept inline because SIEM alerts are small — if payloads start
                exceeding a few KB they belong in MinIO behind a storage reference, the
                same way EvidenceItem blobs will.
            -->
            <column name="payload" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="payload_sha256" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="trigger_event"/>
        </rollback>
    </changeSet>

    <changeSet id="0002-2" author="dfraas-team">
        <comment>Dedupe key: an external id is only unique within the system that issued it</comment>
        <!--
            Composite, not a bare unique index on external_event_id. Two different SIEMs
            can legitimately both emit alert "12345"; making external_event_id globally
            unique would silently discard the second one as a duplicate.
        -->
        <addUniqueConstraint
            tableName="trigger_event"
            columnNames="source_system, external_event_id"
            constraintName="uq_trigger_event_source_external"/>
        <rollback>
            <dropUniqueConstraint
                tableName="trigger_event"
                constraintName="uq_trigger_event_source_external"/>
        </rollback>
    </changeSet>

    <changeSet id="0002-3" author="dfraas-team">
        <comment>Guarantee payload_sha256 really holds a lowercase SHA-256 hex digest</comment>
        <!--
            addCheckConstraint is a Liquibase Pro tag, so this is raw SQL. Worth the
            awkwardness: the integrity story rests on this column, and a constraint in
            the database holds for writes that never pass through the application.
        -->
        <sql>
            ALTER TABLE trigger_event
                ADD CONSTRAINT ck_trigger_event_payload_sha256
                CHECK (payload_sha256 ~ '^[a-f0-9]{64}$');
        </sql>
        <rollback>
            <sql>
                ALTER TABLE trigger_event
                    DROP CONSTRAINT ck_trigger_event_payload_sha256;
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="0002-4" author="dfraas-team">
        <comment>Supports time-window queries over received events</comment>
        <!--
            No separate index on source_system: it is the leading column of
            uq_trigger_event_source_external, so that index already serves lookups
            filtered by source alone.
        -->
        <createIndex tableName="trigger_event" indexName="ix_trigger_event_fired_at">
            <column name="fired_at"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="trigger_event" indexName="ix_trigger_event_fired_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
