# DFRaaS local development environment variables.
# Copy to .env and adjust. Every value here is a DEV-ONLY placeholder
#
#   cp .env.example .env

# --- Postgres (metadata store) ---------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=dfraas
POSTGRES_USER=dfraas
POSTGRES_PASSWORD=dfraas_dev_only

# --- MinIO (evidence blob storage) -----------------------------------------
# In production these are replaced by KMS/HSM-backed envelope encryption
# credentials, not a static access key pair.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=dfraas_admin
MINIO_SECRET_KEY=dfraas_dev_only
MINIO_BUCKET=evidence-store

# --- Kafka / Redpanda (trigger event transport) ----------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CONSUMER_GROUP=dfraas-ingestion
KAFKA_EVIDENCE_TOPIC=evidence-events

# --- Dev-only application login --------------------------------------------
# Temporary stand-in until the AppUser entity backs a real UserDetailsService.
DEV_ADMIN_USER=admin
DEV_ADMIN_PASSWORD=admin

# --- Browser origins allowed to call the API -------------------------------
# The Vite dev server (5173) and `vite preview` (4173). Comma-separated,
# never a wildcard — see backend config/SecurityConfiguration.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
