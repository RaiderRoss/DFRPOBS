# NOTE: this file is listed LAST in each service's env_file, so it overrides
# the Spring-events default set in fineract-common.env.

# --- Remote job message handler ---------------------------------------------
# The spring-events handler only works on an all-in-one node (batch manager AND
# batch worker enabled in the same JVM). This deployment splits manager/worker,
# so jobs must be dispatched over Kafka instead.
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_SPRING_EVENTS_ENABLED=false
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_KAFKA_ENABLED=true
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_KAFKA_TOPIC_NAME=job-topic
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_KAFKA_TOPIC_AUTO_CREATE=true
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_KAFKA_TOPIC_REPLICAS=1
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_KAFKA_TOPIC_PARTITIONS=10

# --- External events --------------------------------------------------------
# Publishes Avro-encoded business events to the "external-events" topic, which
# is what Kafka_Listener/listener.py subscribes to.
FINERACT_EXTERNAL_EVENTS_ENABLED=true
FINERACT_EXTERNAL_EVENTS_KAFKA_ENABLED=true
FINERACT_EXTERNAL_EVENTS_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
FINERACT_EXTERNAL_EVENTS_KAFKA_TOPIC_NAME=external-events
FINERACT_EXTERNAL_EVENTS_KAFKA_TOPIC_AUTO_CREATE=true
FINERACT_EXTERNAL_EVENTS_KAFKA_TOPIC_REPLICAS=1
FINERACT_EXTERNAL_EVENTS_KAFKA_TOPIC_PARTITIONS=10
